@model Nop.Web.Areas.Admin.Models.Catalog.ManufacturerListModel
@{ ViewData["Title"] = "Manufacturers"; }

<h1>Manufacturers</h1>

<form asp-action="List" method="get" id="search-form">
    <div>
        <label>Manufacturer name</label>
        <input asp-for="SearchManufacturerName" />
    </div>
    <div>
        <label>Store</label>
        <select asp-for="SearchStoreId" asp-items="Model.AvailableStores"></select>
    </div>
    <button type="submit" id="search-manufacturers">Search</button>
</form>

<p>
    <a asp-action="Create">Add new</a>
</p>

@* Manufacturer grid — populated via AJAX POST to ManufacturerList *@
<div id="manufacturers-grid">
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Published</th>
                <th>Display order</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="manufacturers-tbody"></tbody>
    </table>
    <div id="manufacturers-pager"></div>
</div>

<form asp-action="ExportExcel" method="post">
    <button type="submit">Export to Excel</button>
</form>

<form asp-action="ImportExcel" method="post" enctype="multipart/form-data">
    <input type="file" name="importexcelfile" />
    <button type="submit">Import from Excel</button>
</form>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        loadManufacturers(1, 15);
    });

    document.getElementById('search-manufacturers')?.addEventListener('click', function (e) {
        e.preventDefault();
        loadManufacturers(1, 15);
    });

    function loadManufacturers(page, pageSize) {
        const form = document.getElementById('search-form');
        const data = new URLSearchParams(new FormData(form));
        data.append('Page', page);
        data.append('PageSize', pageSize);

        fetch('@Url.Action("ManufacturerList", "Manufacturer", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || '' },
            body: data
        })
        .then(r => r.json())
        .then(result => {
            const tbody = document.getElementById('manufacturers-tbody');
            tbody.innerHTML = '';
            if (result.Data) {
                result.Data.forEach(function (m) {
                    const tr = document.createElement('tr');
                    tr.innerHTML = '<td>' + (m.Name || '') + '</td>'
                        + '<td>' + (m.Published ? 'Yes' : 'No') + '</td>'
                        + '<td>' + m.DisplayOrder + '</td>'
                        + '<td><a href="/Admin/Manufacturer/Edit/' + m.Id + '">Edit</a></td>';
                    tbody.appendChild(tr);
                });
            }
            document.getElementById('manufacturers-pager').textContent = 'Total: ' + result.Total;
        });
    }
</script>
}
