@model Nop.Web.Areas.Admin.Models.Customers.CustomerRoleModel
@{ ViewData["Title"] = "Edit customer role — " + Model.Name; }

<h1>Edit customer role — @Model.Name</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Active"></label>
        <input asp-for="Active" />
    </div>
    <div>
        <label asp-for="FreeShipping"></label>
        <input asp-for="FreeShipping" />
    </div>
    <div>
        <label asp-for="TaxExempt"></label>
        <input asp-for="TaxExempt" />
    </div>
    <div>
        <label asp-for="EnablePasswordLifetime"></label>
        <input asp-for="EnablePasswordLifetime" />
    </div>
    <div>
        <label asp-for="SystemName"></label>
        <input asp-for="SystemName" asp-is-disabled="@Model.IsSystemRole" />
        @if (Model.IsSystemRole)
        {
            <input asp-for="SystemName" type="hidden" />
            <span>(system role — cannot be changed)</span>
        }
    </div>
    <div>
        <label asp-for="PurchasedWithProductId"></label>
        <input asp-for="PurchasedWithProductId" />
        @if (!string.IsNullOrEmpty(Model.PurchasedWithProductName))
        {
            <span>@Model.PurchasedWithProductName</span>
        }
        @* AssociateProductToCustomerRolePopup deferred — enter product ID manually for now *@
    </div>

    <button type="submit" name="continueEditing" value="false">Save</button>
    <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
</form>

<form asp-action="Delete" method="post" id="delete-form">
    <input name="id" type="hidden" value="@Model.Id" />
    @if (!Model.IsSystemRole)
    {
        <button type="submit" onclick="return confirm('Are you sure you want to delete this customer role?');">Delete</button>
    }
</form>

<p><a asp-action="List">back to customer role list</a></p>
