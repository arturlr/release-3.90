@model Nop.Web.Areas.Admin.Models.Shipping.WarehouseModel
@{ ViewData["Title"] = "Edit warehouse"; }

<h1>Edit warehouse</h1>

<form asp-action="EditWarehouse" method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="AdminComment"></label>
        <textarea asp-for="AdminComment"></textarea>
    </div>
    <fieldset>
        <legend>Address</legend>
        <div>
            <label>Country</label>
            <select asp-for="Address.CountryId" asp-items="Model.Address.AvailableCountries"></select>
        </div>
        <div>
            <label>State / province</label>
            <select asp-for="Address.StateProvinceId" asp-items="Model.Address.AvailableStates"></select>
        </div>
        <div>
            <label>City</label>
            <input asp-for="Address.City" />
        </div>
        <div>
            <label>Address 1</label>
            <input asp-for="Address.Address1" />
        </div>
        <div>
            <label>Zip / postal code</label>
            <input asp-for="Address.ZipPostalCode" />
        </div>
        <div>
            <label>Phone number</label>
            <input asp-for="Address.PhoneNumber" />
        </div>
    </fieldset>
    <button type="submit" name="continueEditing" value="false">Save</button>
    <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
</form>

<form asp-action="DeleteWarehouse" method="post" style="display:inline">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" onclick="return confirm('Are you sure?')">Delete</button>
</form>
