@model Nop.Web.Areas.Admin.Models.Shipping.ShippingMethodModel
@{ ViewData["Title"] = "Add a new shipping method"; }

<h1>Add a new shipping method</h1>

<form asp-action="CreateMethod" method="post">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Description"></label>
        <textarea asp-for="Description"></textarea>
    </div>
    <div>
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" />
    </div>
    <button type="submit" name="continueEditing" value="false">Save</button>
    <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
</form>
