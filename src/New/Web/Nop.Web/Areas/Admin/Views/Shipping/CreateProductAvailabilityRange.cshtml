@model Nop.Web.Areas.Admin.Models.Shipping.ProductAvailabilityRangeModel
@{ ViewData["Title"] = "Add a new product availability range"; }

<h1>Add a new product availability range</h1>

<form asp-action="CreateProductAvailabilityRange" method="post">
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" />
    </div>
    <button type="submit" name="continueEditing" value="false">Save</button>
    <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
</form>
