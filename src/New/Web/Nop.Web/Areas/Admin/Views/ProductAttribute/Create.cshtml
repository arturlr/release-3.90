@model Nop.Web.Areas.Admin.Models.Catalog.ProductAttributeModel
@{ ViewData["Title"] = "Add a new product attribute"; }

<h1>Add a new product attribute</h1>

<form asp-action="Create" method="post">
    <input type="hidden" name="continueEditing" value="false" id="continueEditingField" />

    <div>
        <label asp-for="Name">Name</label>
        <input asp-for="Name" />
    </div>
    <div>
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" rows="4"></textarea>
    </div>

    <button type="submit">Save</button>
    <button type="submit" onclick="document.getElementById('continueEditingField').value='true';">Save and continue editing</button>
</form>
