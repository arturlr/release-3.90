@model Nop.Web.Areas.Admin.Models.Blogs.BlogCommentListModel
@{ ViewData["Title"] = "Blog Comments"; }

<h1>Blog Comments</h1>

<form id="search-form">
    <input type="hidden" name="FilterByBlogPostId" value="@Model.FilterByBlogPostId" />
    <div>
        <label>Created from</label>
        <input name="CreatedOnFrom" type="date" value="@Model.CreatedOnFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label>Created to</label>
        <input name="CreatedOnTo" type="date" value="@Model.CreatedOnTo?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label>Approved</label>
        <select name="SearchApprovedId" asp-items="Model.AvailableApprovedOptions"></select>
    </div>
    <div>
        <label>Comment text</label>
        <input name="SearchText" value="@Model.SearchText" />
    </div>
    <button type="submit" id="search-comments">Search</button>
</form>

<p>
    <button type="button" id="approve-selected-btn">Approve selected</button>
    <button type="button" id="disapprove-selected-btn">Disapprove selected</button>
    <button type="button" id="delete-selected-btn">Delete selected</button>
</p>

<div id="comments-grid">
    <table>
        <thead>
            <tr>
                <th><input type="checkbox" id="select-all" /></th>
                <th>Blog post</th>
                <th>Customer</th>
                <th>Comment</th>
                <th>Approved</th>
                <th>Store</th>
                <th>Created on</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="comments-tbody"></tbody>
    </table>
    <div id="comments-pager"></div>
</div>

<a asp-action="List">Back to blog posts</a>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function () { loadComments(1, 15); });
    document.getElementById('search-comments')?.addEventListener('click', function (e) { e.preventDefault(); loadComments(1, 15); });
    document.getElementById('select-all')?.addEventListener('change', function () {
        document.querySelectorAll('.comment-checkbox').forEach(function (cb) { cb.checked = this.checked; }.bind(this));
    });

    function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }

    function getSelectedIds() {
        return Array.from(document.querySelectorAll('.comment-checkbox:checked')).map(function (cb) { return cb.value; });
    }

    function loadComments(page, pageSize) {
        const form = document.getElementById('search-form');
        const data = new URLSearchParams(new FormData(form));
        data.append('Page', page);
        data.append('PageSize', pageSize);

        fetch('@Url.Action("CommentList", "Blog", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getToken() },
            body: data
        })
        .then(function (r) { return r.json(); })
        .then(function (result) {
            var tbody = document.getElementById('comments-tbody');
            tbody.innerHTML = '';
            if (result.Data) {
                result.Data.forEach(function (c) {
                    var tr = document.createElement('tr');
                    tr.innerHTML = '<td><input type="checkbox" class="comment-checkbox" value="' + c.Id + '" /></td>'
                        + '<td><a href="/Admin/Blog/Edit/' + c.BlogPostId + '">' + (c.BlogPostTitle || '') + '</a></td>'
                        + '<td>' + (c.CustomerInfo || '') + '</td>'
                        + '<td>' + (c.Comment || '') + '</td>'
                        + '<td>' + (c.IsApproved ? 'Yes' : 'No') + '</td>'
                        + '<td>' + (c.StoreName || '') + '</td>'
                        + '<td>' + (c.CreatedOn || '') + '</td>'
                        + '<td><button onclick="deleteComment(' + c.Id + ')">Delete</button></td>';
                    tbody.appendChild(tr);
                });
            }
            document.getElementById('comments-pager').textContent = 'Total: ' + result.Total;
        });
    }

    function deleteComment(id) {
        if (!confirm('Are you sure?')) return;
        fetch('@Url.Action("CommentDelete", "Blog", new { area = "Admin" })', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getToken() },
            body: 'id=' + id
        }).then(function () { loadComments(1, 15); });
    }

    function bulkAction(url) {
        var ids = getSelectedIds();
        if (ids.length === 0) return;
        var body = ids.map(function (id) { return 'selectedIds=' + id; }).join('&');
        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getToken() },
            body: body
        }).then(function () { loadComments(1, 15); });
    }

    document.getElementById('delete-selected-btn')?.addEventListener('click', function () {
        if (confirm('Delete selected comments?'))
            bulkAction('@Url.Action("DeleteSelectedComments", "Blog", new { area = "Admin" })');
    });
    document.getElementById('approve-selected-btn')?.addEventListener('click', function () {
        bulkAction('@Url.Action("ApproveSelected", "Blog", new { area = "Admin" })');
    });
    document.getElementById('disapprove-selected-btn')?.addEventListener('click', function () {
        bulkAction('@Url.Action("DisapproveSelected", "Blog", new { area = "Admin" })');
    });
</script>
}
