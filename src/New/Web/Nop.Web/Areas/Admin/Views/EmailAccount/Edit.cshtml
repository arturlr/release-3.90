@model Nop.Web.Areas.Admin.Models.Messages.EmailAccountModel
@{ ViewData["Title"] = "Edit email account"; }

<h1>Edit email account - @Model.Email</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Email">Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label asp-for="DisplayName">Display name</label>
        <input asp-for="DisplayName" />
    </div>
    <div>
        <label asp-for="Host">Host</label>
        <input asp-for="Host" />
    </div>
    <div>
        <label asp-for="Port">Port</label>
        <input asp-for="Port" />
    </div>
    <div>
        <label asp-for="Username">Username</label>
        <input asp-for="Username" />
    </div>
    <div>
        <label asp-for="EnableSsl">Enable SSL</label>
        <input asp-for="EnableSsl" />
    </div>
    <div>
        <label asp-for="UseDefaultCredentials">Use default credentials</label>
        <input asp-for="UseDefaultCredentials" />
    </div>
    <div>
        <button type="submit" name="continueEditing" value="false">Save</button>
        <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
    </div>
</form>

<h2>Change password</h2>
<form asp-action="ChangePassword" asp-route-id="@Model.Id" method="post">
    <div>
        <label asp-for="Password">New password</label>
        <input asp-for="Password" type="password" />
    </div>
    <div>
        <button type="submit">Change password</button>
    </div>
</form>

<h2>Send test email</h2>
<form asp-action="SendTestEmail" asp-route-id="@Model.Id" method="post">
    <div>
        <label asp-for="SendTestEmailTo">Send test email to</label>
        <input asp-for="SendTestEmailTo" />
    </div>
    <div>
        <button type="submit">Send test email</button>
    </div>
</form>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
    <button type="submit" onclick="return confirm('Are you sure you want to delete this email account?');">Delete</button>
</form>
