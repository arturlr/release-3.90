@model Nop.Web.Areas.Admin.Models.Directory.CurrencyModel
@{ ViewData["Title"] = "Add a new currency"; }

<h1>Add a new currency</h1>

<form asp-action="Create" asp-route-continueEditing="false" method="post">
    <div>
        <label asp-for="Name">Name</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="CurrencyCode">Currency code</label>
        <input asp-for="CurrencyCode" />
        <span asp-validation-for="CurrencyCode"></span>
    </div>
    <div>
        <label asp-for="Rate">Rate</label>
        <input asp-for="Rate" />
        <span asp-validation-for="Rate"></span>
    </div>
    <div>
        <label asp-for="DisplayLocale">Display locale</label>
        <input asp-for="DisplayLocale" />
    </div>
    <div>
        <label asp-for="CustomFormatting">Custom formatting</label>
        <input asp-for="CustomFormatting" />
    </div>
    <div>
        <label asp-for="Published">Published</label>
        <input asp-for="Published" />
    </div>
    <div>
        <label asp-for="DisplayOrder">Display order</label>
        <input asp-for="DisplayOrder" />
    </div>
    <div>
        <label asp-for="RoundingTypeId">Rounding type</label>
        <select asp-for="RoundingTypeId">
            <option value="0">Default rounding</option>
            <option value="10">Rounding up with 0.05 intervals</option>
            <option value="20">Rounding down with 0.05 intervals</option>
            <option value="30">Rounding up with 0.10 intervals</option>
            <option value="40">Rounding down with 0.10 intervals</option>
            <option value="50">Rounding up with 0.50 intervals</option>
            <option value="60">Rounding with 1.00 intervals</option>
            <option value="70">Rounding up with 1.00 intervals</option>
        </select>
    </div>
    @* Localization deferred (consistent with all other admin controllers) *@
    @* Store mapping deferred (consistent with all other admin controllers) *@
    <div>
        <button type="submit" name="continueEditing" value="false">Save</button>
        <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
    </div>
</form>
