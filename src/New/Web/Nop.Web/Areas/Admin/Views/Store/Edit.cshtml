@model Nop.Web.Areas.Admin.Models.Stores.StoreModel
@{
    ViewData["Title"] = "Edit store";
}

<h3>Edit store — @Model.Name</h3>

<form asp-action="Edit" asp-area="Admin" method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Url"></label>
        <input asp-for="Url" />
        <span asp-validation-for="Url"></span>
    </div>
    <div>
        <label asp-for="SslEnabled"></label>
        <input asp-for="SslEnabled" />
    </div>
    <div>
        <label asp-for="SecureUrl"></label>
        <input asp-for="SecureUrl" />
    </div>
    <div>
        <label asp-for="Hosts"></label>
        <textarea asp-for="Hosts"></textarea>
    </div>
    <div>
        <label asp-for="DefaultLanguageId"></label>
        <select asp-for="DefaultLanguageId" asp-items="Model.AvailableLanguages"></select>
    </div>
    <div>
        <label asp-for="DisplayOrder"></label>
        <input asp-for="DisplayOrder" />
    </div>
    <div>
        <label asp-for="CompanyName"></label>
        <input asp-for="CompanyName" />
    </div>
    <div>
        <label asp-for="CompanyAddress"></label>
        <input asp-for="CompanyAddress" />
    </div>
    <div>
        <label asp-for="CompanyPhoneNumber"></label>
        <input asp-for="CompanyPhoneNumber" />
    </div>
    <div>
        <label asp-for="CompanyVat"></label>
        <input asp-for="CompanyVat" />
    </div>
    <div>
        <button type="submit" name="continueEditing" value="false">Save</button>
        <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
    </div>
</form>

<form asp-action="Delete" asp-area="Admin" asp-route-id="@Model.Id" method="post"
      onsubmit="return confirm('Are you sure you want to delete this store?');">
    <button type="submit" class="btn btn-danger">Delete</button>
</form>
