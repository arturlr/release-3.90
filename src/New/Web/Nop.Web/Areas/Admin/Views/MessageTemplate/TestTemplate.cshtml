@model Nop.Web.Areas.Admin.Models.Messages.TestMessageTemplateModel
@{ ViewData["Title"] = "Test message template"; }

<h1>Test message template</h1>

<form asp-action="SendTestTemplate" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="LanguageId" type="hidden" />
    <div>
        <label asp-for="SendTo">Send to</label>
        <input asp-for="SendTo" />
    </div>
    @if (Model.Tokens.Count > 0)
    {
        <h2>Token values</h2>
        @foreach (var token in Model.Tokens)
        {
            <div>
                <label>@token</label>
                <input name="token_@token.Replace("%", "")" value="" />
            </div>
        }
    }
    <div>
        <button type="submit">Send test email</button>
    </div>
</form>

<a href="@Url.Action("Edit", "MessageTemplate", new { area = "Admin", id = Model.Id })">Back to edit</a>
