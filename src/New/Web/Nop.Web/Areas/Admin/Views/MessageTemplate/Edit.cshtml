@model Nop.Web.Areas.Admin.Models.Messages.MessageTemplateModel
@{ ViewData["Title"] = "Edit message template - " + Model.Name; }

<h1>Edit message template - @Model.Name</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div>
        <label asp-for="Name">Name</label>
        <input asp-for="Name" readonly="readonly" />
    </div>
    <div>
        <label>Allowed tokens</label>
        <textarea readonly="readonly" rows="3" style="width:100%;">@Model.AllowedTokens</textarea>
    </div>
    <div>
        <label asp-for="BccEmailAddresses">BCC</label>
        <input asp-for="BccEmailAddresses" />
    </div>
    <div>
        <label asp-for="Subject">Subject</label>
        <input asp-for="Subject" />
    </div>
    <div>
        <label asp-for="Body">Body</label>
        <textarea asp-for="Body" rows="15" style="width:100%;"></textarea>
    </div>
    <div>
        <label asp-for="IsActive">Is active</label>
        <input asp-for="IsActive" type="checkbox" />
    </div>
    <div>
        <label asp-for="SendImmediately">Send immediately</label>
        <input asp-for="SendImmediately" type="checkbox" />
    </div>
    <div>
        <label asp-for="DelayBeforeSend">Delay before send</label>
        <input asp-for="DelayBeforeSend" type="number" />
        <select asp-for="DelayPeriodId">
            <option value="0">Hours</option>
            <option value="1">Days</option>
        </select>
    </div>
    <div>
        <label asp-for="HasAttachedDownload">Has attached download</label>
        <input asp-for="HasAttachedDownload" type="checkbox" />
        <input asp-for="AttachedDownloadId" type="number" />
    </div>
    <div>
        <label asp-for="EmailAccountId">Email account</label>
        <select asp-for="EmailAccountId">
            @foreach (var ea in Model.AvailableEmailAccounts)
            {
                <option value="@ea.Id">@ea.DisplayName</option>
            }
        </select>
    </div>
    <div>
        <label asp-for="LimitedToStores">Limited to stores</label>
        <input asp-for="LimitedToStores" type="checkbox" />
        @* Store mapping management deferred — consistent with all other admin controllers *@
    </div>
    <div>
        <button type="submit" name="continueEditing" value="false">Save</button>
        <button type="submit" name="continueEditing" value="true">Save and continue editing</button>
    </div>
</form>

<h2>Actions</h2>
<div style="display:flex; gap:10px;">
    <form asp-action="CopyTemplate" asp-route-id="@Model.Id" method="post" style="display:inline;">
        <button type="submit">Copy template</button>
    </form>
    <a href="@Url.Action("TestTemplate", "MessageTemplate", new { area = "Admin", id = Model.Id })">
        <button type="button">Test template</button>
    </a>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
        <button type="submit" onclick="return confirm('Are you sure you want to delete this message template?');">Delete</button>
    </form>
</div>
