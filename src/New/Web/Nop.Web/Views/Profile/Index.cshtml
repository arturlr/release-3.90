@model Nop.Web.Models.Profile.ProfileIndexModel
<div class="page profile-page">
    <div class="page-title">
        <h1>@Model.ProfileTitle</h1>
    </div>
    <div class="page-body">
        <div class="tabs profile-tabs">
            <ul class="tabs-header">
                <li><a href="#" data-tab="info" class="@(Model.PagingPosts ? "" : "active")">Personal Info</a></li>
                @if (Model.ForumsEnabled)
                {
                    <li><a href="#" data-tab="posts" class="@(Model.PagingPosts ? "active" : "")">Latest Posts</a></li>
                }
            </ul>

            <div id="tab-info" class="tab-content" style="@(Model.PagingPosts && Model.ForumsEnabled ? "display:none" : "")">
                @await Html.PartialAsync("_Info", Model.Info)
            </div>

            @if (Model.ForumsEnabled)
            {
                <div id="tab-posts" class="tab-content" style="@(!Model.PagingPosts ? "display:none" : "")">
                    @await Html.PartialAsync("_Posts", Model.Posts)
                </div>
            }
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.profile-tabs .tabs-header a').forEach(function (tab) {
        tab.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelectorAll('.profile-tabs .tabs-header a').forEach(function (t) { t.classList.remove('active'); });
            document.querySelectorAll('.profile-tabs .tab-content').forEach(function (c) { c.style.display = 'none'; });
            this.classList.add('active');
            var target = document.getElementById('tab-' + this.dataset.tab);
            if (target) target.style.display = '';
        });
    });
</script>
