@model IList<Nop.Web.Models.Polls.PollModel>
@if (Model.Count > 0)
{
    <div class="home-page-polls">
        <div class="title">
            <strong>Poll</strong>
        </div>
        @foreach (var poll in Model)
        {
            <partial name="_Poll" model="poll" />
        }
    </div>
}
