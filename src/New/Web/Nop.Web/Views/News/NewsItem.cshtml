@model Nop.Web.Models.News.NewsItemModel
<div class="page newsitem-page">
    <div class="page-title">
        <h1>@Model.Title</h1>
    </div>
    <div class="page-body">
        <div class="news-date">@Model.CreatedOn.ToString("D")</div>
        <div class="news-body">
            @Html.Raw(Model.Full)
        </div>
        @if (Model.AllowComments)
        {
            <div class="fieldset new-comment" id="comments">
                <div class="title"><strong>Leave your comment</strong></div>
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="message-error">
                        <div asp-validation-summary="ModelOnly"></div>
                    </div>
                }
                @if (TempData["nop.news.addcomment.result"] is string result && !string.IsNullOrEmpty(result))
                {
                    <div class="result">@result</div>
                }
                <form asp-action="NewsItem" asp-route-newsItemId="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-fields">
                        <div class="inputs">
                            <label asp-for="AddNewComment.CommentTitle">Title:</label>
                            <input asp-for="AddNewComment.CommentTitle" class="enter-comment-title" />
                        </div>
                        <div class="inputs">
                            <label asp-for="AddNewComment.CommentText">Comment:</label>
                            <textarea asp-for="AddNewComment.CommentText" class="enter-comment-text"></textarea>
                        </div>
                    </div>
                    <div class="buttons">
                        <input type="submit" name="add-comment" class="button-1 news-item-add-comment-button" value="Submit comment" />
                    </div>
                </form>
            </div>
            @if (Model.Comments.Count > 0)
            {
                <div class="comment-list">
                    <div class="title"><strong>Comments</strong></div>
                    <div class="comments">
                        @foreach (var comment in Model.Comments)
                        {
                            <div class="comment news-comment">
                                <div class="comment-content">
                                    @if (!string.IsNullOrEmpty(comment.CommentTitle))
                                    {
                                        <div class="comment-title">
                                            <strong>@System.Net.WebUtility.HtmlEncode(comment.CommentTitle)</strong>
                                        </div>
                                    }
                                    <div class="comment-time">
                                        <label>Created on:</label>
                                        <span>@comment.CreatedOn.ToString("g")</span>
                                    </div>
                                    <div class="comment-body">
                                        @Html.Raw(System.Net.WebUtility.HtmlEncode(comment.CommentText ?? "").Replace("\n", "<br />"))
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
