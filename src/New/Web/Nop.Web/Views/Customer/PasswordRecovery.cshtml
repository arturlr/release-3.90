@model Nop.Web.Models.Customer.PasswordRecoveryModel
@{
    ViewData["Title"] = "Password Recovery";
}
<h1>Password Recovery</h1>
@if (!string.IsNullOrEmpty(Model.Result))
{
    <p>@Model.Result</p>
}
<form asp-action="PasswordRecovery" method="post">
    <div>
        <label asp-for="Email"></label>
        <input asp-for="Email" />
    </div>
    <button type="submit" name="send-email" value="send-email">Recover</button>
</form>
