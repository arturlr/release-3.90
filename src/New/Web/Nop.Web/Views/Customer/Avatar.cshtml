@model Nop.Web.Models.Customer.CustomerAvatarModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><title>Avatar</title></head>
<body>
<h1>Avatar</h1>
@if (!string.IsNullOrEmpty(Model.AvatarUrl))
{
    <img src="@Model.AvatarUrl" alt="Avatar" />
}
<div asp-validation-summary="ModelOnly"></div>
<form asp-action="UploadAvatar" method="post" enctype="multipart/form-data">
    <input type="file" name="uploadedFile" />
    <button type="submit">Upload</button>
</form>
<form asp-action="RemoveAvatar" method="post">
    <button type="submit">Remove Avatar</button>
</form>
</body>
</html>
