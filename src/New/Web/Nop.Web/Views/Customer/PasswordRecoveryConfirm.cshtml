@model Nop.Web.Models.Customer.PasswordRecoveryConfirmModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><title>Password Recovery Confirm</title></head>
<body>
<h1>Set New Password</h1>
@if (!string.IsNullOrEmpty(Model.Result))
{
    <p>@Model.Result</p>
}
@if (!Model.DisablePasswordChanging)
{
    <div asp-validation-summary="ModelOnly"></div>
    <form asp-action="PasswordRecoveryConfirm" method="post">
        <div>
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" />
        </div>
        <div>
            <label asp-for="ConfirmNewPassword"></label>
            <input asp-for="ConfirmNewPassword" />
        </div>
        <button type="submit" name="set-password" value="set-password">Set Password</button>
    </form>
}
</body>
</html>
