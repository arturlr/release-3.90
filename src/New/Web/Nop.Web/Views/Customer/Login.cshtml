@model Nop.Web.Models.Customer.LoginModel
@{ Layout = null; }
<!DOCTYPE html>
<html>
<head><title>Login</title></head>
<body>
<h1>Login</h1>
<div asp-validation-summary="ModelOnly"></div>
<form asp-action="Login" asp-route-returnUrl="@Context.Request.Query["returnUrl"]" method="post">
    @if (Model.UsernamesEnabled)
    {
        <div>
            <label asp-for="Username"></label>
            <input asp-for="Username" />
        </div>
    }
    else
    {
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" />
        </div>
    }
    <div>
        <label asp-for="Password"></label>
        <input asp-for="Password" />
    </div>
    <div>
        <label asp-for="RememberMe"></label>
        <input asp-for="RememberMe" />
    </div>
    <button type="submit">Log in</button>
</form>
<p><a asp-action="PasswordRecovery">Forgot password?</a></p>
<p><a asp-action="Register">Register</a></p>
</body>
</html>
