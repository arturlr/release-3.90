@model Nop.Web.Models.PrivateMessages.PrivateMessageIndexModel
<div class="page private-messages">
    <h1>Private Messages</h1>

    <div class="tabs inbox-tabs">
        <ul class="tabs-header">
            <li><a href="#" data-tab="inbox" class="@(Model.SentItemsTabSelected ? "" : "active")">Inbox</a></li>
            <li><a href="#" data-tab="sent" class="@(Model.SentItemsTabSelected ? "active" : "")">Sent Items</a></li>
        </ul>

        @* --- Inbox Tab --- *@
        <div id="tab-inbox" class="tab-content" style="@(Model.SentItemsTabSelected ? "display:none" : "")">
            @if (Model.InboxMessages.Messages.Count > 0)
            {
                <form asp-action="DeleteInboxPM" method="post">
                    @Html.AntiForgeryToken()
                    <table class="data-table" id="pm-inbox-table">
                        <thead>
                            <tr>
                                <th class="select"><input type="checkbox" id="select-all-inbox" /></th>
                                <th class="from">From</th>
                                <th class="subject">Subject</th>
                                <th class="date">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.InboxMessages.Messages)
                            {
                                <tr>
                                    <td class="select">
                                        <input type="checkbox" name="inboxIds" value="@item.Id" class="inbox-checkbox" />
                                    </td>
                                    <td class="from">@item.CustomerFromName</td>
                                    <td class="subject">
                                        <a href="@Url.Action("ViewPM", "PrivateMessages", new { privateMessageId = item.Id })"
                                           class="@(item.IsRead ? "pm-read" : "pm-unread")">@item.Subject</a>
                                    </td>
                                    <td class="date">@item.CreatedOn.ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="buttons">
                        <button type="submit" class="button-1">Delete Selected</button>
                    </div>
                </form>
                <form asp-action="MarkUnread" method="post" id="mark-unread-form" style="display:inline">
                    @Html.AntiForgeryToken()
                    <div class="buttons" style="display:inline">
                        <button type="submit" class="button-2">Mark as Unread</button>
                    </div>
                </form>
            }
            else
            {
                <div class="no-data">No messages.</div>
            }
        </div>

        @* --- Sent Items Tab --- *@
        <div id="tab-sent" class="tab-content" style="@(Model.SentItemsTabSelected ? "" : "display:none")">
            @if (Model.SentMessages.Messages.Count > 0)
            {
                <form asp-action="DeleteSentPM" method="post">
                    @Html.AntiForgeryToken()
                    <table class="data-table" id="pm-sent-table">
                        <thead>
                            <tr>
                                <th class="select"><input type="checkbox" id="select-all-sent" /></th>
                                <th class="to">To</th>
                                <th class="subject">Subject</th>
                                <th class="date">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SentMessages.Messages)
                            {
                                <tr>
                                    <td class="select">
                                        <input type="checkbox" name="sentIds" value="@item.Id" class="sent-checkbox" />
                                    </td>
                                    <td class="to">@item.CustomerToName</td>
                                    <td class="subject">
                                        <a href="@Url.Action("ViewPM", "PrivateMessages", new { privateMessageId = item.Id })"
                                           class="pm-read">@item.Subject</a>
                                    </td>
                                    <td class="date">@item.CreatedOn.ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="buttons">
                        <button type="submit" class="button-1">Delete Selected</button>
                    </div>
                </form>
            }
            else
            {
                <div class="no-data">No messages.</div>
            }
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.tabs-header a').forEach(function (link) {
        link.addEventListener('click', function (e) {
            e.preventDefault();
            document.querySelectorAll('.tabs-header a').forEach(function (a) { a.classList.remove('active'); });
            document.querySelectorAll('.tab-content').forEach(function (t) { t.style.display = 'none'; });
            this.classList.add('active');
            document.getElementById('tab-' + this.dataset.tab).style.display = '';
        });
    });

    document.getElementById('select-all-inbox')?.addEventListener('change', function () {
        document.querySelectorAll('.inbox-checkbox').forEach(function (cb) { cb.checked = this.checked; }.bind(this));
    });
    document.getElementById('select-all-sent')?.addEventListener('change', function () {
        document.querySelectorAll('.sent-checkbox').forEach(function (cb) { cb.checked = this.checked; }.bind(this));
    });

    // Copy checked inbox IDs to mark-unread form
    document.getElementById('mark-unread-form')?.addEventListener('submit', function () {
        this.querySelectorAll('input[name="inboxIds"]').forEach(function (el) { el.remove(); });
        document.querySelectorAll('.inbox-checkbox:checked').forEach(function (cb) {
            var input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'inboxIds';
            input.value = cb.value;
            document.getElementById('mark-unread-form').appendChild(input);
        });
    });
</script>
