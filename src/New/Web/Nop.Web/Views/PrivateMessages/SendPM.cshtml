@model Nop.Web.Models.PrivateMessages.SendPrivateMessageModel
@{
    Layout = null;
}
<div class="page private-messages private-message-send-page">
    <h1>Send Private Message</h1>
    <form asp-action="SendPM" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ToCustomerId" />
        <input type="hidden" asp-for="ReplyToMessageId" />
        <div asp-validation-summary="ModelOnly" class="message-error"></div>
        <div class="fieldset">
            <div class="form-fields">
                <div class="inputs">
                    <label>To:</label>
                    <span>@Model.CustomerToName</span>
                </div>
                <div class="inputs">
                    <label asp-for="Subject">Subject:</label>
                    <input asp-for="Subject" class="pm-title-text" />
                    <span asp-validation-for="Subject"></span>
                </div>
                <div class="inputs message">
                    <label asp-for="Message">Message:</label>
                    <textarea asp-for="Message" class="bb-editor-text"></textarea>
                    <span asp-validation-for="Message"></span>
                </div>
            </div>
        </div>
        <div class="buttons">
            <button type="submit" class="button-1 send-pm-button">Send</button>
            <a href="@Url.Action("Index", "PrivateMessages")" class="button-2 cancel-pm-button">Cancel</a>
        </div>
    </form>
</div>
