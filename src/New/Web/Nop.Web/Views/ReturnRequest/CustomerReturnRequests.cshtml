@model Nop.Web.Models.Order.CustomerReturnRequestsModel
<div class="page account-page return-request-list-page">
    <div class="page-title">
        <h1>My Account - Return Requests</h1>
    </div>
    <div class="page-body">
        @if (!Model.Items.Any())
        {
            <div class="no-data">No return requests</div>
        }
        @foreach (var item in Model.Items)
        {
            <div class="section request-item">
                <div class="title">
                    <strong>Return Request #@item.CustomNumber - @item.ReturnRequestStatus</strong>
                </div>
                <ul class="details">
                    <li class="product">
                        <label>Item:</label>
                        <a href="@Url.Action("ProductDetails", "Product", new { productId = item.ProductId })">@item.ProductName</a>
                        <span>x @item.Quantity</span>
                    </li>
                    <li class="reason">
                        <label>Return Reason:</label>
                        <span>@item.ReturnReason</span>
                    </li>
                    <li class="action">
                        <label>Return Action:</label>
                        <span>@item.ReturnAction</span>
                    </li>
                    <li class="date">
                        <label>Date:</label>
                        <span>@item.CreatedOn.ToString()</span>
                    </li>
                    @if (item.UploadedFileGuid != Guid.Empty)
                    {
                        <li class="uploaded-file">
                            <label>Uploaded File:</label>
                            <span>
                                <a href="@Url.Action("GetFileUpload", "Download", new { downloadId = item.UploadedFileGuid.ToString() })">
                                    Download
                                </a>
                            </span>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(item.Comments))
                    {
                        <li class="comments">
                            <label>Comments:</label>
                            <div>@Html.Raw(item.Comments?.Replace("\n", "<br />"))</div>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>
