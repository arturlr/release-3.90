@model List<Nop.Web.Models.Catalog.ProductOverviewModel>
@{
    ViewData["Title"] = "Recently Viewed Products";
}
    <div class="recently-viewed-products-page">
        <h1>Recently Viewed Products</h1>
        @if (Model.Count == 0)
        {
            <div class="no-data">You have no recently viewed products.</div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model)
                {
                    <partial name="Catalog/_ProductBox" model="product" />
                }
            </div>
        }
    </div>
