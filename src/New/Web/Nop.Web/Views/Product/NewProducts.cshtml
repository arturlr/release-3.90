@model List<Nop.Web.Models.Catalog.ProductOverviewModel>
@{
    Layout = null;
    ViewData["Title"] = "New Products";
}
<!DOCTYPE html>
<html>
<head>
    <title>New Products</title>
</head>
<body>
    <div class="new-products-page">
        <h1>New Products</h1>
        @if (Model.Count == 0)
        {
            <div class="no-data">No new products found.</div>
        }
        else
        {
            <div class="product-grid">
                @foreach (var product in Model)
                {
                    <partial name="Catalog/_ProductBox" model="product" />
                }
            </div>
        }
    </div>
</body>
</html>
