@model Nop.Web.Models.Boards.BoardsIndexModel

@{
    Layout = null;
    ViewData["Title"] = "Forums";
}

<h1>Forums</h1>

@foreach (var group in Model.ForumGroups)
{
    <div class="forum-group">
        <h2>@group.Name</h2>
        <table class="table">
            <thead>
                <tr>
                    <th>Forum</th>
                    <th>Topics</th>
                    <th>Posts</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var forum in group.Forums)
                {
                    <tr>
                        <td>
                            <a asp-action="Forum" asp-route-id="@forum.Id">@forum.Name</a>
                            @if (!string.IsNullOrEmpty(forum.Description))
                            {
                                <p>@forum.Description</p>
                            }
                        </td>
                        <td>@forum.NumTopics</td>
                        <td>@forum.NumPosts</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p><a asp-action="ActiveDiscussions">Active Discussions</a></p>
