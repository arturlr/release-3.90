<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nop.Core - the Leaf_Project of the migration (Requirements 1.1, 1.2, 1.3, 1.5, 5.1).

    Converted from the classic (non-SDK) MSBuild format. Dropped in the conversion:
      * ToolsVersion / DefaultTargets / xmlns MSBuild 2003 attributes
      * ProjectGuid, ProductVersion, SchemaVersion, FileAlignment, AppDesignerFolder,
        OutputType (Library is the SDK default), TargetFrameworkProfile
      * TargetFrameworkVersion v4.5.1
      * The Debug|AnyCPU / Release|AnyCPU PropertyGroup pair (the SDK supplies
        equivalent Debug/Release defaults)
      * Import of $(MSBuildToolsPath)\Microsoft.CSharp.targets and the commented
        BeforeBuild/AfterBuild target stubs
      * The explicit <Compile Include="..."/> list of 290 files - replaced by the SDK's
        implicit globbing
      * BCL <Reference Include="System.*"/> entries (System, System.Core, System.Data,
        System.Xml, System.Xml.Linq, System.Data.DataSetExtensions, Microsoft.CSharp,
        System.configuration, System.IO.Compression, System.ComponentModel.Composition,
        System.Runtime.Caching, System.Web) - subsumed by the shared framework or
        replaced by packages in later tasks
      * <Reference/> items with HintPaths into ..\..\packages\ (Autofac,
        Autofac.Integration.Mvc, AutoMapper, Microsoft.Web.Infrastructure,
        Newtonsoft.Json, RedLock.StrongName, StackExchange.Redis.StrongName,
        System.Web.Mvc/Razor/WebPages/Helpers) - the packages.config surface, now
        re-declared below as version-less <PackageReference/> items
      * <None Include="app.config"/> and <None Include="packages.config"/> - both files
        are deleted (packages.config in task 2.2, app.config in task 2.3)

    Also removed in task 2.3: Infrastructure\NopStarter.cs (dead [Obsolete(..., true)]
    code that the classic project deliberately omitted from its <Compile/> list) together
    with the <Compile Remove/>/<None Include/> pair that task 2.1 used to keep it out of
    the implicit glob.

    TargetFramework, Nullable, ImplicitUsings, GenerateAssemblyInfo and the shared
    assembly metadata come from src/Directory.Build.props; net10.0 is restated here so
    the target framework is verifiable from the project file itself (Requirement 1.2).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    ASP.NET Core shared framework (design section 5, consumed by task 2.4).

    Nop.Core is a class library, so the ASP.NET Core surface it needs is obtained with a
    FrameworkReference rather than individual Microsoft.AspNetCore.* packages. This
    supplies, among others:
      * Microsoft.AspNetCore.Http / .Http.Abstractions - HttpContext, IHttpContextAccessor
        for the WebHelper and PerRequestCacheManager rewrites
      * Microsoft.Extensions.Caching.Memory - IMemoryCache for the MemoryCacheManager
        rewrite (replaces the System.Runtime.Caching BCL reference)
      * Microsoft.Extensions.Configuration[.Json/.Binder] and Microsoft.Extensions.Options -
        replacements for ConfigurationManager / app.config access
    Adding NuGet packages for any of the above would duplicate assemblies already in the
    shared framework, so they are deliberately not declared.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    packages.config -> PackageReference (Requirements 1.3, 1.5).

    Versions are governed centrally by src/Directory.Packages.props
    (ManagePackageVersionsCentrally=true, CentralPackageVersionOverrideEnabled=false),
    so every item below is intentionally version-less.

    Only DIRECT dependencies are declared - PackageReference is transitive by default,
    unlike packages.config which enumerated the whole closure. Each entry was verified
    against actual source usage:

      Autofac              Infrastructure\DependencyManagement\ContainerManager.cs,
                           Infrastructure\NopEngine.cs
      AutoMapper           Infrastructure\NopEngine.cs
      Newtonsoft.Json      Caching\RedisCacheManager.cs
      StackExchange.Redis  Caching\RedisCacheManager.cs, Caching\RedisConnectionWrapper.cs,
                           Caching\IRedisConnectionWrapper.cs
      RedLock.net          Caching\RedisConnectionWrapper.cs

    Dropped from the legacy packages.config and NOT restated:
      Microsoft.Web.Infrastructure   transitive-only, no net10.0 equivalent
      Microsoft.AspNet.Mvc           System.Web.Mvc      - no net10.0 equivalent;
      Microsoft.AspNet.Razor         System.Web.Razor      superseded by ASP.NET Core MVC
      Microsoft.AspNet.WebPages      System.Web.WebPages   in the shared framework above
      Autofac.Mvc5                   Autofac.Integration.Mvc - superseded by
                                     Autofac.Extensions.DependencyInjection (wired up in
                                     Nop.Web.Framework, task 6.4)
    The source files that still reference those types are rewritten in task 2.4.

    Version floor: the net45-era pins in packages.config (Autofac 4.4.0, AutoMapper 5.2.0,
    Newtonsoft.Json 9.0.1) and the discontinued StrongName variants
    (StackExchange.Redis.StrongName 1.2.1, RedLock.net.StrongName 1.7.4) are advanced to
    the net10.0-compatible mainline versions pinned centrally.
  -->
  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="RedLock.net" />
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

</Project>
