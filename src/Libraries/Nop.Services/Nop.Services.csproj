<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Nop.Services - third stage of the migration, downstream of Nop.Core and Nop.Data
    (Requirements 1.1, 1.2, 1.3, 1.4, 1.5, 2.4, 5.8, 5.10).

    Converted from the classic (non-SDK) MSBuild format. Dropped in the conversion:
      * ToolsVersion / DefaultTargets / xmlns MSBuild 2003 attributes
      * ProjectGuid {210541AD-F659-47DA-8763-16F36C5CD2F4}, ProductVersion,
        SchemaVersion, FileAlignment, AppDesignerFolder, OutputType (Library is the
        SDK default), TargetFrameworkProfile, NuGetPackageImportStamp
      * TargetFrameworkVersion v4.5.1
      * The Debug|AnyCPU / Release|AnyCPU PropertyGroup pair (the SDK supplies
        equivalent Debug/Release defaults)
      * Import of $(MSBuildToolsPath)\Microsoft.CSharp.targets, the commented
        BeforeBuild/AfterBuild target stubs, the Microsoft.Bcl.Build.targets import
        and its EnsureNuGetPackageBuildImports guard target
      * The explicit <Compile Include="..."/> list of 320 files - replaced by the
        SDK's implicit globbing
      * BCL <Reference Include="System.*"/> entries (System, System.Core, System.Data,
        System.Xml, System.Xml.Linq, System.Data.DataSetExtensions, Microsoft.CSharp,
        System.Net, System.Net.Http, System.Net.Http.WebRequest, System.Numerics,
        System.EnterpriseServices, System.Web, System.Web.Services) - subsumed by the
        net10.0 shared framework, replaced by packages below, or (System.Web*,
        System.EnterpriseServices) with no net10.0 counterpart at all
      * <Reference Include="System.Drawing" /> - deliberately NOT restated. The
        Windows-only System.Drawing.Common surface (Bitmap/Graphics/Imaging) used by
        Media\PictureService.cs is replaced by SixLabors.ImageSharp in task 4.2
        (design section 7, Requirements 5.8, 5.10). The only other System.Drawing usage
        in the project - Color.FromArgb in ExportImport\ExportManager.cs - lives in
        System.Drawing.Primitives, which IS part of the cross-platform net10.0 shared
        framework, so it needs no reference and no rewrite.
      * <Reference/> items with HintPaths into ..\..\packages\ - the packages.config
        surface, re-declared below as version-less <PackageReference/> items
      * <WebReferences/> and <WebReferenceUrl/> items for the legacy ASMX
        "Web References\EuropaCheckVatService" proxy - the WebReference build feature
        does not exist in the SDK. The generated Reference.cs (and the
        Properties\Settings.* pair that supplied its endpoint URL) were retained on
        disk by this task and DELETED by task 4.2 - see the note below.
      * <None Include="app.config"/> and <None Include="packages.config"/> - both
        files are deleted in this task (Requirements 1.4, 1.5). app.config held only a
        <startup> element, .NET Framework binding redirects, and the
        applicationSettings section backing the ASMX endpoint URL; nothing in it
        survives on net10.0. No source file in this project reads
        ConfigurationManager, so there is no appSettings surface to carry over to
        IConfiguration.

    Properties/AssemblyInfo.cs is retained (matching Nop.Core and Nop.Data) and
    GenerateAssemblyInfo=false in src/Directory.Build.props keeps the SDK from
    emitting a duplicate set of assembly attributes.

    TargetFramework, Nullable, ImplicitUsings, GenerateAssemblyInfo and the shared
    assembly metadata come from src/Directory.Build.props; net10.0 is restated here so
    the target framework is verifiable from the project file itself (Requirement 1.2).
    It is intentionally the OS-agnostic net10.0 and NOT net10.0-windows: with
    System.Drawing gone, nothing left in this project is Windows-only
    (Requirement 5.10, design section 7).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    ASP.NET Core shared framework - REQUIRED here, unlike Nop.Data.

    Nop.Data needed no FrameworkReference because nothing in it touched System.Web.
    Nop.Services does, extensively, so it follows Nop.Core's pattern instead:
      * HttpContextBase constructor parameters / fields in 6 files -
        Authentication\FormsAuthenticationService.cs, Catalog\CompareProductsService.cs,
        Catalog\RecentlyViewedProductsService.cs, Common\MaintenanceService.cs,
        Helpers\UserAgentHelper.cs, Media\PictureService.cs
        -> Microsoft.AspNetCore.Http (IHttpContextAccessor) in task 4.2
      * "using System.Web;" in 15 files (HttpUtility, HttpPostedFile, cookies)
        -> Microsoft.AspNetCore.Http / System.Net.WebUtility in task 4.2
      * System.Web.Mvc in 6 files (ExportImport\Help\PropertyManager.cs,
        Authentication\External\AuthorizeState.cs and others) and System.Web.Routing in
        7 files -> Microsoft.AspNetCore.Mvc / endpoint routing in task 4.2
    All of the replacement surfaces above ship in the Microsoft.AspNetCore.App shared
    framework, so a FrameworkReference is the right vehicle for a class library -
    adding individual Microsoft.AspNetCore.* packages would duplicate assemblies.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    packages.config -> PackageReference (Requirements 1.3, 1.5).

    Versions are governed centrally by src/Directory.Packages.props
    (ManagePackageVersionsCentrally=true, CentralPackageVersionOverrideEnabled=false),
    so every item below is intentionally version-less.

    Only DIRECT dependencies are declared - PackageReference is transitive by default,
    unlike packages.config which enumerated the whole closure. Each entry was verified
    against actual source usage:

      Autofac                       Tasks\Task.cs ("using Autofac;", ILifetimeScope)
      EPPlus                        ExportImport\ExportManager.cs,
                                    ExportImport\ImportManager.cs,
                                    ExportImport\Help\PropertyManager.cs
                                    (OfficeOpenXml, OfficeOpenXml.Style: ExcelPackage,
                                    ExcelWorksheet, ExcelStyle, ExcelFillStyle)
      iTextSharp.LGPLv2.Core        Common\PdfService.cs (iTextSharp.text,
                                    iTextSharp.text.pdf: Document, PdfWriter, PdfPTable,
                                    PdfPCell, Paragraph, Phrase, Font, BaseFont,
                                    BaseColor, PageSize, Rectangle, Image, Anchor)
      MaxMind.GeoIP2                Directory\GeoLookupService.cs (DatabaseReader,
                                    CountryResponse, GeoIP2Exception)
      Microsoft.Azure.Storage.Blob  Media\AzurePictureService.cs (CloudStorageAccount,
                                    CloudBlobClient, CloudBlobContainer)
      Microsoft.Data.SqlClient      Common\MaintenanceService.cs (SqlConnection,
                                    SqlCommand, SqlConnection.ClearAllPools). Reachable
                                    transitively through Nop.Data -> EF Core SqlServer,
                                    but declared because this project binds against it
                                    directly (same rationale Nop.Data used for
                                    Microsoft.EntityFrameworkCore.Relational).
      SixLabors.ImageSharp          Media\PictureService.cs - the replacement for
                                    ImageResizer + System.Drawing, consumed by task 4.2
                                    (Requirements 5.8, 5.9, 5.11, design section 7)
      System.Linq.Dynamic.Core      Messages\Tokenizer.cs (dynamic LINQ Where/Select)

    Dropped from the legacy packages.config / <Reference> list and NOT restated:

      ImageResizer 4.0.5                  no net10.0 release exists; the package is a
      ImageResizer.Plugins.PrettyGifs     net45/System.Web-era pipeline built on
                                          System.Drawing. Replaced by
                                          SixLabors.ImageSharp, whose built-in
                                          GifEncoder performs the palette quantization
                                          PrettyGifs provided (design section 7).
      iTextSharp 5.5.10                   5.x has no netstandard/net10.0 asset at all
                                          (5.5.13.6, the last release, is
                                          .NETFramework4.6.1-only). See the licence and
                                          API notes in Directory.Packages.props.
      EPPlus 4.1.0                        advanced to 4.5.3.3, the last LGPL-3.0
                                          release, which is the first EPPlus 4.x line
                                          shipping netstandard2.0/2.1 assets.
      WindowsAzure.Storage 8.1.1          superseded by Microsoft.Azure.Storage.Blob
      Microsoft.Azure.KeyVault.Core       transitive of the Azure storage package
                                          (client-side encryption); not used here
      Microsoft.Data.Edm                  transitive of WindowsAzure.Storage's table
      Microsoft.Data.OData                surface; no source file in this project
      Microsoft.Data.Services.Client      references any of them
      System.Spatial
      MaxMind.Db 2.1.3                    transitive of MaxMind.GeoIP2; no source file
                                          references the MaxMind.Db namespace
      Newtonsoft.Json 9.0.1               no usage - no file in this project references
                                          Newtonsoft.Json or JsonConvert
      System.Linq.Dynamic 1.0.7           net40-only; replaced by
                                          System.Linq.Dynamic.Core (namespace change is
                                          task 4.2)
      Microsoft.AspNet.Mvc                System.Web.Mvc / .Razor / .WebPages have no
      Microsoft.AspNet.Razor              net10.0 equivalent; superseded by ASP.NET Core
      Microsoft.AspNet.WebPages           MVC in the shared framework above
      Microsoft.Web.Infrastructure        transitive-only, no net10.0 equivalent
      Microsoft.Bcl                       net45-era BCL polyfills (Task/async, HttpClient)
      Microsoft.Bcl.Async                 subsumed by the net10.0 shared framework
      Microsoft.Bcl.Build
      Microsoft.Net.Http
      System.ComponentModel.EventBasedAsync   4.3.0-era netstandard shims, all subsumed
      System.Dynamic.Runtime                  by the net10.0 shared framework
      System.Linq.Queryable
      System.Net.Http
      System.Net.Requests

    AutoMapper is NOT declared. The task description anticipated an AutoMapper advance,
    but no file under Nop.Services references AutoMapper (it was never in this
    project's packages.config either) - the mapper lives in Nop.Core's NopEngine and in
    Nop.Web.Framework. Declaring it here would be an undeclared-usage violation of the
    direct-dependency rule.

    KNOWN GAP left for task 4.2 - CLOSED BY TASK 4.2, no package was needed:
    "Web References\EuropaCheckVatService\Reference.cs" was a generated ASMX proxy
    deriving from System.Web.Services.Protocols.SoapHttpClientProtocol, consumed by
    Tax\TaxService.cs (EU VAT validation). SoapHttpClientProtocol has no net10.0
    implementation in the framework or in any NuGet package. Task 4.2 DELETED the whole
    "Web References" folder together with Properties\Settings.Designer.cs and
    Properties\Settings.settings (which existed solely to supply that proxy's endpoint
    URL through System.Configuration.ApplicationSettingsBase), and reimplemented the
    single checkVat operation inside TaxService.CheckVatEuropa using HttpClient plus a
    hand-built SOAP 1.1 envelope parsed with System.Xml.Linq - both in the net10.0
    shared framework, so NO PackageReference was added for it. See section 8 ("EU VAT
    SOAP client") of runtime-deferrals.md in the spec folder.
  -->
  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="EPPlus" />
    <PackageReference Include="iTextSharp.LGPLv2.Core" />
    <PackageReference Include="MaxMind.GeoIP2" />
    <PackageReference Include="Microsoft.Azure.Storage.Blob" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>

  <!--
    ProjectReferences to the already-migrated SDK-style Nop.Core and Nop.Data
    (Requirement 2.4). The legacy <Project>{6BDA8332-...}</Project> /
    <Name>Nop.Core</Name> and <Project>{CCD7F2C9-...}</Project> /
    <Name>Nop.Data</Name> metadata children are dropped - the SDK resolves references
    by path.
  -->
  <ItemGroup>
    <ProjectReference Include="..\Nop.Core\Nop.Core.csproj" />
    <ProjectReference Include="..\Nop.Data\Nop.Data.csproj" />
  </ItemGroup>

</Project>
