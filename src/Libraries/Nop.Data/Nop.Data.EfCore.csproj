<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Nop.Data</AssemblyName>
    <RootNamespace>Nop.Data</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="5.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="5.0.17" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="5.0.17" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nop.Core\Nop.Core.NetStandard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude EF6 files, include EF Core files -->
    <Compile Remove="**/*.cs" />
    <Compile Include="IDbContext.EfCore.cs" />
    <Compile Include="NopDbContext.cs" />
    <Compile Include="EfCoreRepository.cs" />
    <Compile Include="IRepository.EfCore.cs" />
    <Compile Include="Mapping\NopEntityTypeConfiguration.EfCore.cs" />
    <Compile Include="Mapping\**\*.EfCore.cs" />
  </ItemGroup>

</Project>
