// -----------------------------------------------------------------------------------------
// Nop.Web application configuration - task 7.4 (Requirements 1.4, 5.3).
//
// This file is the .NET 10 replacement for the APPLICATION portion of 3.90's
// src/Presentation/Nop.Web/Web.config. Every value below is a FAITHFUL translation of the
// element it replaces; the legacy source is named in the comment above each block. Values
// that had no legacy counterpart are marked NEW.
//
// Web.config now contains only the IIS/ANCM hosting shim - see the header comment there for
// the element-by-element disposition of everything that used to live in it.
//
// The JSON configuration provider skips // comments and allows trailing commas
// (JsonConfigurationFileParser uses JsonCommentHandling.Skip), so the documentation below is
// legal and is deliberately kept next to the values.
//
// Wiring, for reference:
//   Program.cs -> builder.Environment.UseNopHostingEnvironment(builder.Configuration)
//                   publishes this IConfiguration on Nop.Core's NopConfigurationManager,
//                   which is what makes the "NopConfig" and "appSettings" sections below
//                   resolve (runtime deferral 1.4 / 7.2-4).
//   Program.cs -> builder.Services.AddNopFramework(builder.Configuration)
//                   binds the "Authentication" section into NopAuthenticationConfig and
//                   registers it for IOptions<NopAuthenticationConfig> injection.
//
// NOT here, on purpose: the DATABASE CONNECTION STRING. 3.90 never kept it in Web.config -
// there is no <connectionStrings> element anywhere in the legacy file. It lives in
// App_Data/Settings.txt, written by the installer and read by
// Nop.Core.Data.DataSettingsManager through CommonHelper.MapPath("~/App_Data/"), which now
// resolves against the content root (runtime deferral 1.5, closed by task 7.2). That file is
// excluded from publish output - see the deferral 39 block in Nop.Web.csproj.
// -----------------------------------------------------------------------------------------
{
  // =======================================================================================
  // <NopConfig> custom section  ->  Nop.Core.Configuration.NopConfig
  //
  // Legacy mechanism: a System.Configuration.IConfigurationSectionHandler declared in
  // <configSections>. The handler type has no net10.0 counterpart, so task 2.3 turned
  // NopConfig into a plain options POCO that binds from IConfiguration. Every property name
  // and type is unchanged, so the flattened keys below map one-for-one onto the nested
  // legacy attributes.
  //
  // Consumers: NopEngine (IgnoreStartupTasks), RedisCacheManager /
  // RedisConnectionWrapper (Redis*), UserAgentHelper (*UserAgentStringsPath),
  // AzurePictureService (AzureBlobStorage*), Nop.Services.Tasks.Task and
  // WebHelper (MultipleInstancesEnabled / RunOnAzureWebApps), the installation services
  // (Disable/UseFast/PluginsIgnored) and Nop.Admin's SettingController.
  // =======================================================================================
  "NopConfig": {

    // NEW-BUT-NOT-INVENTED: the shipped 3.90 Web.config has no <Startup> element, so the
    // section handler left this at its `false` default. Stated explicitly for discoverability.
    "IgnoreStartupTasks": false,

    // <UserAgentStrings databasePath="~/App_Data/browscap.xml"
    //                   crawlersOnlyDatabasePath="~/App_Data/browscap.crawlersonly.xml" />
    // Both resolve through CommonHelper.MapPath, i.e. against the content root.
    // Setting these is what un-deads IUserAgentHelper.IsSearchEngine() - see the
    // runtime-deferrals.md 7.20 note. BrowscapXmlHelper parses the 46 MB browscap.xml once
    // on first use and then writes the small crawlers-only file, exactly as in 3.90.
    // Leave CrawlerOnlyUserAgentStringsPath empty to always parse the full file.
    "UserAgentStringsPath": "~/App_Data/browscap.xml",
    "CrawlerOnlyUserAgentStringsPath": "~/App_Data/browscap.crawlersonly.xml",

    // <RedisCaching Enabled="false" ConnectionString="localhost" />
    "RedisCachingEnabled": false,
    "RedisCachingConnectionString": "localhost",

    // <SupportPreviousNopcommerceVersions Enabled="True" />
    // "Set to False if you did not upgrade from a previous version - slightly faster."
    "SupportPreviousNopcommerceVersions": true,

    // <WebFarms MultipleInstancesEnabled="False" RunOnAzureWebApps="False" />
    // Enable MultipleInstancesEnabled only when you actually run more than one instance.
    // NOTE for a multi-instance deployment, carried over from runtime deferrals 7.13 / 15 /
    // 36: you must ALSO share the ASP.NET Core Data Protection key ring (otherwise auth
    // cookies stop validating across instances - the modern equivalent of <machineKey>) and
    // configure a distributed session store (see the "Redis" note in Web.config's header).
    "MultipleInstancesEnabled": false,
    "RunOnAzureWebApps": false,

    // <AzureBlobStorage ConnectionString="" ContainerName="" EndPoint="" />
    "AzureBlobStorageConnectionString": "",
    "AzureBlobStorageContainerName": "",
    "AzureBlobStorageEndPoint": "",

    // <Installation DisableSampleDataDuringInstallation="False"
    //               UseFastInstallationService="False"
    //               PluginsIgnoredDuringInstallation="" />
    // "Do not edit this element. For advanced users only."
    "DisableSampleDataDuringInstallation": false,
    "UseFastInstallationService": false,
    "PluginsIgnoredDuringInstallation": ""
  },

  // =======================================================================================
  // <appSettings>  ->  read through Nop.Core.Configuration.NopConfigurationManager
  //                    .GetAppSetting(name), which probes "appSettings:<name>" first and
  //                    then a root-level key.
  //
  // Only the keys that still have a live consumer are carried over. The four that do not are
  // System.Web / OWIN / MVC5 artifacts with no counterpart and are DELIBERATELY DROPPED:
  //
  //   owin:AutomaticAppStartup       OWIN host startup discovery - there is no OWIN host.
  //   webpages:Version               System.Web.WebPages version pinning.
  //   webpages:Enabled  ("false")    disabled the WebPages route handler; no such handler.
  //   PreserveLoginUrl  ("true")     a System.Web forms-authentication quirk switch.
  //
  // Two more were MVC 5 *view-level* switches rather than settings:
  //   ClientValidationEnabled        ("true") - ASP.NET Core's equivalent is
  //                                  MvcViewOptions.HtmlHelperOptions.ClientValidationEnabled,
  //                                  which is ALREADY true by default, so 3.90's value is
  //                                  preserved with no configuration at all.
  //   UnobtrusiveJavaScriptEnabled   ("true") - ASP.NET Core emits only unobtrusive
  //                                  data-val-* attributes; there is no other mode to
  //                                  switch away from.
  // =======================================================================================
  "appSettings": {

    // Read by Nop.Core.Plugins.PluginManager.Initialize(). This key is absent from 3.90's
    // shipped Web.config (the code documents a `false` default) but IS a real 3.90 app
    // setting with a live consumer, so it is stated here rather than left implicit.
    // Set to "true" to wipe ~/Plugins/bin on every startup.
    "ClearPluginsShadowDirectoryOnStartup": "false"

    // ---- The three load-balancer keys below were COMMENTED OUT in 3.90's Web.config and
    // ---- are therefore left commented out here, so the shipped behaviour is identical.
    // ---- Consumers: Nop.Core.WebHelper (IsCurrentConnectionSecured / GetCurrentIpAddress).
    // ----
    // ---- READ FIRST: task 7.2 registers app.UseForwardedHeaders() with
    // ---- XForwardedFor | XForwardedProto (runtime deferral 11.29), which is the SUPPORTED
    // ---- way to sit behind a TLS-terminating proxy and is what makes
    // ---- HttpRequest.IsHttps correct. Prefer it. These keys remain only for a proxy that
    // ---- uses a non-standard header.
    //
    // "Use_HTTP_CLUSTER_HTTPS":      "true",   // trust the HTTP_CLUSTER_HTTPS variable
    // "Use_HTTP_X_FORWARDED_PROTO":  "true",   // trust the X-FORWARDED-PROTO header
    // "ForwardedHTTPheader":         "CF-Connecting-IP"  // e.g. behind Cloudflare
  },

  // =======================================================================================
  // <system.web><authentication mode="Forms"><forms ... />
  //   ->  Nop.Web.Framework.Infrastructure.NopAuthenticationConfig
  //       (bound by AddNopFramework(IConfiguration); task 6.5 created the POCO)
  //
  // The legacy element, verbatim:
  //   <forms name="NOPCOMMERCE.AUTH" loginUrl="~/login" protection="All"
  //          timeout="43200" path="/" requireSSL="false" slidingExpiration="true" />
  //
  //   name               -> CookieName
  //   loginUrl="~/login" -> LoginPath="/login". ASP.NET Core's PathString has no "~/"
  //                         application-relative form; the rooted path is equivalent.
  //   timeout="43200"    -> TimeoutMinutes (30 days). This MUST be set on the handler:
  //                         FormsAuthenticationService has no ambient
  //                         FormsAuthentication.Timeout to read and would otherwise fall
  //                         back to a 30-MINUTE default (runtime deferral 7.13).
  //   path               -> CookiePath
  //   requireSSL         -> RequireSsl (see the security note below)
  //   slidingExpiration  -> SlidingExpiration
  //   protection="All"   -> NO COUNTERPART AND NONE NEEDED. The forms ticket's own
  //                         encryption+MAC is replaced by ASP.NET Core Data Protection,
  //                         which is always on for the auth cookie.
  //
  // *** SECURITY - READ BEFORE DEPLOYING (runtime deferral 7.13) ***
  // RequireSsl is false because that is what 3.90 SHIPPED (requireSSL="false"), and this
  // migration does not silently change defaults. It maps to
  // CookieSecurePolicy.Always when true and SameAsRequest when false.
  // If YOUR 3.90 Web.config had requireSSL="true", set it to true here or the port is a
  // security DOWNGRADE. Any HTTPS-only storefront should set it to true.
  // =======================================================================================
  "Authentication": {
    "CookieName": "NOPCOMMERCE.AUTH",
    "LoginPath": "/login",
    "TimeoutMinutes": 43200,
    "RequireSsl": false,
    "SlidingExpiration": true,
    "CookiePath": "/"
  },

  // =======================================================================================
  // <Properties/Settings.settings>  ->  Tax:EuropaCheckVatServiceUrl
  //
  // Closes runtime deferral 16 / 7.16. In 3.90 the EU VIES checkVat endpoint URL lived in
  // Nop.Services/Properties/Settings.settings and was read through
  // System.Configuration.ApplicationSettingsBase by the generated ASMX proxy. Task 4.2 deleted
  // the proxy and both settings files (SoapHttpClientProtocol has no net10.0 implementation) and
  // hardcoded the URL as TaxService.DefaultEuropaCheckVatServiceUrl. It is configuration again.
  //
  // DELIBERATE BEHAVIOUR CHANGE, as deferral 7.16 itself recommended: the retired WSDL declared
  // the endpoint over plain HTTP, so 3.90 sent VAT numbers and received company names and
  // addresses in the clear. The default below - and TaxService's fallback constant - are now
  // HTTPS. VIES serves the same operation at the same path over TLS. A deployment that must go
  // back to plain http can set that here without a recompile, which is the point.
  //
  // Consumer: TaxService.EuropaCheckVatServiceUrl (still protected virtual, so a subclass can
  // still override outright).
  // =======================================================================================
  "Tax": {
    "EuropaCheckVatServiceUrl": "https://ec.europa.eu/taxation_customs/vies/services/checkVatService"
  },

  // =======================================================================================
  // NEW - no legacy counterpart, stated as required by the faithfulness rule.
  //
  // 3.90's nearest equivalent was <system.web><trace enabled="false" localOnly="true" />,
  // which is not a logging configuration. ASP.NET Core needs no "Logging" section to run;
  // without one the console provider defaults to Information, which floods the console with
  // per-request framework noise. These are the standard ASP.NET Core template values and
  // change no nopCommerce behaviour - nopCommerce's own logging remains ILogger/DefaultLogger
  // writing to the Log database table.
  // =======================================================================================
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
