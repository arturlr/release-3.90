@model Nop.Core.Domain.Orders.Order

@{
    ViewData["Title"] = $"Order #{Model?.Id}";
}

<div style="margin-bottom: 2rem;">
    <a href="/Order/CustomerOrders" style="color: #007bff;">&larr; Back to Orders</a>
</div>

@if (Model == null)
{
    <div class="alert alert-error">Order not found</div>
}
else
{
    <h1 style="margin-bottom: 1rem;">Order #@Model.Id</h1>
    <p style="color: #666; margin-bottom: 2rem;">Placed on @Model.CreatedOnUtc.ToString("MMMM dd, yyyy")</p>

    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">
        <div>
            <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; margin-bottom: 20px;">
                <h2 style="margin-bottom: 1rem;">Order Items</h2>
                <table style="width: 100%; border-collapse: collapse;">
                    <thead>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <th style="text-align: left; padding: 10px;">Product</th>
                            <th style="text-align: center; padding: 10px;">Qty</th>
                            <th style="text-align: right; padding: 10px;">Price</th>
                            <th style="text-align: right; padding: 10px;">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr style="border-bottom: 1px solid #ddd;">
                            <td style="padding: 10px;">Sample Product</td>
                            <td style="text-align: center; padding: 10px;">1</td>
                            <td style="text-align: right; padding: 10px;">$@Model.OrderTotal</td>
                            <td style="text-align: right; padding: 10px;">$@Model.OrderTotal</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
                <h2 style="margin-bottom: 1rem;">Shipping Address</h2>
                <p>
                    @Model.ShippingAddress?.FirstName @Model.ShippingAddress?.LastName<br />
                    @Model.ShippingAddress?.Address1<br />
                    @Model.ShippingAddress?.City, @Model.ShippingAddress?.ZipPostalCode
                </p>
            </div>
        </div>

        <div>
            <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; background: #f8f9fa;">
                <h3 style="margin-bottom: 1rem;">Order Summary</h3>
                <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                    <div style="display: flex; justify-content: space-between;">
                        <span>Status:</span>
                        <strong>@Model.OrderStatus</strong>
                    </div>
                </div>
                <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                    <div style="display: flex; justify-content: space-between;">
                        <span>Subtotal:</span>
                        <span>$@Model.OrderSubtotalInclTax</span>
                    </div>
                </div>
                <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                    <div style="display: flex; justify-content: space-between;">
                        <span>Shipping:</span>
                        <span>$@Model.OrderShippingInclTax</span>
                    </div>
                </div>
                <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                    <div style="display: flex; justify-content: space-between;">
                        <span>Tax:</span>
                        <span>$@Model.OrderTax</span>
                    </div>
                </div>
                <div style="padding: 10px 0;">
                    <div style="display: flex; justify-content: space-between; font-size: 1.2rem; font-weight: bold;">
                        <span>Total:</span>
                        <span style="color: #007bff;">$@Model.OrderTotal</span>
                    </div>
                </div>
                <a href="/Order/ReOrder/@Model.Id" class="btn" style="width: 100%; text-align: center; margin-top: 1rem;">Reorder</a>
            </div>
        </div>
    </div>
}
