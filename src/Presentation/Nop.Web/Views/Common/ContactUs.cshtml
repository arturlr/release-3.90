@{
    ViewData["Title"] = "Contact Us";
}

<div style="max-width: 600px; margin: 0 auto;">
    <h1 style="margin-bottom: 2rem;">Contact Us</h1>
    
    <p style="color: #666; margin-bottom: 2rem;">
        Have a question or feedback? We'd love to hear from you. Fill out the form below and we'll get back to you as soon as possible.
    </p>

    <form method="post" action="/Common/ContactUs">
        <div class="form-group">
            <label>Your Email:</label>
            <input type="email" name="email" required />
        </div>
        
        <div class="form-group">
            <label>Subject:</label>
            <input type="text" name="subject" required />
        </div>
        
        <div class="form-group">
            <label>Message:</label>
            <textarea name="message" rows="6" required></textarea>
        </div>
        
        <button type="submit" class="btn" style="width: 100%;">Send Message</button>
    </form>

    <div style="margin-top: 3rem; padding: 20px; background: #f8f9fa; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">Other Ways to Reach Us</h3>
        <p style="margin: 5px 0;"><strong>Email:</strong> support@nopcommerce.com</p>
        <p style="margin: 5px 0;"><strong>Phone:</strong> 1-800-123-4567</p>
        <p style="margin: 5px 0;"><strong>Hours:</strong> Mon-Fri 9am-5pm EST</p>
    </div>
</div>
