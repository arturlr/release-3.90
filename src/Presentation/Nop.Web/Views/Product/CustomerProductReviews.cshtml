@model CustomerProductReviewsModel
@using Nop.Web.Models.Catalog
@using Nop.Web.Models.Customer;
@{
    Layout = "~/Views/Shared/_ColumnsTwo.cshtml";

    //title
    Html.AddTitleParts(T("PageTitle.CustomerProductReviews").Text);
    //page class
    Html.AppendPageCssClassParts("html-my-product-reviews-list-page");
}
@functions{
    public IHtmlContent GetReviewRow(CustomerProductReviewModel review)
    {
        int ratingPercent = review.Rating * 20;
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"product-review-item\">");
        sb.Append("<div class=\"review-item-head\">");
        sb.Append("<div class=\"review-title\">");
        sb.Append($"<strong>{WebUtility.HtmlEncode(review.Title)}</strong>");
        if (!string.IsNullOrEmpty(review.ApprovalStatus))
        {
            sb.Append($" - {WebUtility.HtmlEncode(review.ApprovalStatus)}");
        }
        sb.Append("</div>");
        sb.Append("<div class=\"product-review-box\">");
        sb.Append("<div class=\"rating\">");
        sb.Append($"<div style=\"width: {ratingPercent}%\">");
        sb.Append("</div>");
        sb.Append("</div>");
        sb.Append("</div>");
        sb.Append("</div>");
        sb.Append("<div class=\"review-content\">");
        sb.Append("<div class=\"review-text\">");
        sb.Append(Nop.Core.Html.HtmlHelper.FormatText(review.ReviewText, false, true, false, false, false, false));
        sb.Append("</div>");
        sb.Append("<div class=\"review-info\">");
        sb.Append("<span class=\"user\">");
        sb.Append($"<label>{WebUtility.HtmlEncode(T("Account.CustomerProductReviews.ProductReviewFor").Text)}:</label>");
        sb.Append($"<a href=\"{Url.RouteUrl("Product", new { SeName = review.ProductSeName })}\">{WebUtility.HtmlEncode(review.ProductName)}</a>");
        sb.Append("</span>");
        sb.Append("<span class=\"separator\">|</span>");
        sb.Append("<span class=\"date\">");
        sb.Append($"<label>{WebUtility.HtmlEncode(T("Reviews.Date").Text)}:</label>");
        sb.Append($"<span>{WebUtility.HtmlEncode(review.WrittenOnStr)}</span>");
        sb.Append("</span>");
        sb.Append("</div>");
        if (!string.IsNullOrEmpty(review.ReplyText))
        {
            sb.Append("<div class=\"reply\">");
            sb.Append("<div class=\"reply-header\">");
            sb.Append(WebUtility.HtmlEncode(T("Reviews.Reply").Text));
            sb.Append("</div>");
            sb.Append("<div class=\"reply-text\">");
            sb.Append(Nop.Core.Html.HtmlHelper.FormatText(review.ReplyText, false, true, false, false, false, false));
            sb.Append("</div>");
            sb.Append("</div>");
        }
        sb.Append("</div>");
        sb.Append("</div>");
        return new HtmlString(sb.ToString());
    }
}
@section left
{
    @Html.Action("CustomerNavigation", "Customer", new { selectedTabId = CustomerNavigationEnum.ProductReviews })
}

<div class="page account-page my-product-reviews-list-page">
    <div class="page-title">
        <h1>@T("Account.MyAccount") - @T("Account.CustomerProductReviews")</h1>
    </div>
    <div class="page-body">
        @if (Model.ProductReviews.Count > 0)
        {
            foreach (var review in Model.ProductReviews)
            {
                @GetReviewRow(review)
            }
            var pager = Html.Pager(Model.PagerModel);
            if (!string.IsNullOrEmpty(pager?.ToString()))
            {
                <div class="pager">
                    @pager
                </div>
            }
        }
        else
        {
            <div class="no-data">
                @T("Account.CustomerProductReviews.NoRecords")
            </div>
        }
    </div>
</div>

