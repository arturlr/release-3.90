@model string

@{
    ViewData["Title"] = Model ?? "Page";
}

<article style="max-width: 800px; margin: 0 auto;">
    <h1 style="margin-bottom: 2rem;">@Model</h1>
    
    <div style="line-height: 1.8;">
        <p>This is a static page. Content would be loaded from the database based on the system name.</p>
        
        <h2 style="margin-top: 2rem;">About Us</h2>
        <p>Welcome to our store! We are committed to providing you with the best products and service.</p>
        
        <h2 style="margin-top: 2rem;">Our Mission</h2>
        <p>To deliver quality products at competitive prices while ensuring customer satisfaction.</p>
        
        <h2 style="margin-top: 2rem;">Contact Information</h2>
        <p>
            Email: info@nopcommerce.com<br />
            Phone: 1-800-123-4567<br />
            Address: 123 Main Street, New York, NY 10001
        </p>
    </div>
</article>
