@{
    ViewData["Title"] = "Checkout";
}

<h1 style="margin-bottom: 2rem;">Checkout</h1>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">
    <div>
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; margin-bottom: 20px;">
            <h2 style="margin-bottom: 1rem;">Billing Address</h2>
            <form method="post" action="/Checkout/BillingAddress">
                <div class="form-group">
                    <label>First Name:</label>
                    <input type="text" name="firstName" required />
                </div>
                <div class="form-group">
                    <label>Last Name:</label>
                    <input type="text" name="lastName" required />
                </div>
                <div class="form-group">
                    <label>Address:</label>
                    <input type="text" name="address1" required />
                </div>
                <div class="form-group">
                    <label>City:</label>
                    <input type="text" name="city" required />
                </div>
                <div class="form-group">
                    <label>Zip Code:</label>
                    <input type="text" name="zip" required />
                </div>
                <button type="submit" class="btn">Continue</button>
            </form>
        </div>
    </div>
    
    <div>
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; background: #f8f9fa;">
            <h3 style="margin-bottom: 1rem;">Order Summary</h3>
            <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Subtotal:</span>
                    <span>$0.00</span>
                </div>
            </div>
            <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Shipping:</span>
                    <span>$0.00</span>
                </div>
            </div>
            <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Tax:</span>
                    <span>$0.00</span>
                </div>
            </div>
            <div style="padding: 10px 0;">
                <div style="display: flex; justify-content: space-between; font-size: 1.2rem; font-weight: bold;">
                    <span>Total:</span>
                    <span style="color: #007bff;">$0.00</span>
                </div>
            </div>
        </div>
    </div>
</div>
