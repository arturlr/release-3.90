@{
    ViewData["Title"] = "Confirm Order";
}

<h1 style="margin-bottom: 2rem;">Confirm Your Order</h1>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 30px;">
    <div>
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; margin-bottom: 20px;">
            <h2 style="margin-bottom: 1rem;">Billing Address</h2>
            <p style="line-height: 1.6;">
                John Doe<br />
                123 Main Street<br />
                New York, NY 10001<br />
                john@example.com
            </p>
        </div>

        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; margin-bottom: 20px;">
            <h2 style="margin-bottom: 1rem;">Shipping Address</h2>
            <p style="line-height: 1.6;">
                John Doe<br />
                123 Main Street<br />
                New York, NY 10001
            </p>
        </div>

        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; margin-bottom: 20px;">
            <h2 style="margin-bottom: 1rem;">Shipping Method</h2>
            <p><strong>Standard Shipping</strong> - $5.00</p>
            <p style="color: #666; font-size: 0.9rem;">5-7 business days</p>
        </div>

        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
            <h2 style="margin-bottom: 1rem;">Payment Method</h2>
            <p><strong>Credit Card</strong></p>
            <p style="color: #666; font-size: 0.9rem;">**** **** **** 1234</p>
        </div>
    </div>

    <div>
        <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px; background: #f8f9fa;">
            <h3 style="margin-bottom: 1rem;">Order Summary</h3>
            <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Subtotal:</span>
                    <span>$99.99</span>
                </div>
            </div>
            <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Shipping:</span>
                    <span>$5.00</span>
                </div>
            </div>
            <div style="border-bottom: 1px solid #ddd; padding: 10px 0;">
                <div style="display: flex; justify-content: space-between;">
                    <span>Tax:</span>
                    <span>$8.50</span>
                </div>
            </div>
            <div style="padding: 10px 0;">
                <div style="display: flex; justify-content: space-between; font-size: 1.2rem; font-weight: bold;">
                    <span>Total:</span>
                    <span style="color: #007bff;">$113.49</span>
                </div>
            </div>
            
            <form method="post" action="/Checkout/ConfirmOrder">
                <button type="submit" class="btn" style="width: 100%; margin-top: 1rem;">Place Order</button>
            </form>
            
            <a href="/Checkout/PaymentMethod" class="btn btn-secondary" style="width: 100%; text-align: center; margin-top: 10px;">Back</a>
        </div>
    </div>
</div>
