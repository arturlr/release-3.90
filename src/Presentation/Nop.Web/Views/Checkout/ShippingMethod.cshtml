@{
    ViewData["Title"] = "Shipping Method";
}

<h1 style="margin-bottom: 2rem;">Checkout - Shipping Method</h1>

<div style="max-width: 600px;">
    <form method="post" action="/Checkout/ShippingMethod">
        <div style="display: grid; gap: 15px; margin-bottom: 2rem;">
            <label style="display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 2px solid #007bff; border-radius: 4px; cursor: pointer; background: #f0f8ff;">
                <div style="display: flex; align-items: center;">
                    <input type="radio" name="shippingMethod" value="1" checked style="margin-right: 10px;" />
                    <div>
                        <strong>Standard Shipping</strong>
                        <p style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0;">5-7 business days</p>
                    </div>
                </div>
                <strong style="color: #007bff;">$5.00</strong>
            </label>

            <label style="display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;">
                <div style="display: flex; align-items: center;">
                    <input type="radio" name="shippingMethod" value="2" style="margin-right: 10px;" />
                    <div>
                        <strong>Express Shipping</strong>
                        <p style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0;">2-3 business days</p>
                    </div>
                </div>
                <strong>$15.00</strong>
            </label>

            <label style="display: flex; justify-content: space-between; align-items: center; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;">
                <div style="display: flex; align-items: center;">
                    <input type="radio" name="shippingMethod" value="3" style="margin-right: 10px;" />
                    <div>
                        <strong>Overnight Shipping</strong>
                        <p style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0;">Next business day</p>
                    </div>
                </div>
                <strong>$25.00</strong>
            </label>
        </div>
        
        <div style="display: flex; gap: 10px;">
            <a href="/Checkout/ShippingAddress" class="btn btn-secondary" style="flex: 1; text-align: center;">Back</a>
            <button type="submit" class="btn" style="flex: 1;">Continue</button>
        </div>
    </form>
</div>
