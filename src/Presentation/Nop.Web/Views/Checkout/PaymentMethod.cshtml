@{
    ViewData["Title"] = "Payment Method";
}

<h1 style="margin-bottom: 2rem;">Checkout - Payment Method</h1>

<div style="max-width: 600px;">
    <form method="post" action="/Checkout/PaymentMethod">
        <div style="display: grid; gap: 15px; margin-bottom: 2rem;">
            <label style="display: flex; align-items: center; padding: 15px; border: 2px solid #007bff; border-radius: 4px; cursor: pointer; background: #f0f8ff;">
                <input type="radio" name="paymentMethod" value="credit-card" checked style="margin-right: 10px;" />
                <div>
                    <strong>Credit Card</strong>
                    <p style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0;">Visa, MasterCard, American Express</p>
                </div>
            </label>

            <label style="display: flex; align-items: center; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;">
                <input type="radio" name="paymentMethod" value="paypal" style="margin-right: 10px;" />
                <div>
                    <strong>PayPal</strong>
                    <p style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0;">Pay securely with PayPal</p>
                </div>
            </label>

            <label style="display: flex; align-items: center; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;">
                <input type="radio" name="paymentMethod" value="purchase-order" style="margin-right: 10px;" />
                <div>
                    <strong>Purchase Order</strong>
                    <p style="color: #666; font-size: 0.9rem; margin: 5px 0 0 0;">Pay by purchase order</p>
                </div>
            </label>
        </div>
        
        <div style="display: flex; gap: 10px;">
            <a href="/Checkout/ShippingMethod" class="btn btn-secondary" style="flex: 1; text-align: center;">Back</a>
            <button type="submit" class="btn" style="flex: 1;">Continue</button>
        </div>
    </form>
</div>
