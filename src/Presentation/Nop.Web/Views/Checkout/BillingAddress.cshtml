@{
    ViewData["Title"] = "Billing Address";
}

<h1 style="margin-bottom: 2rem;">Checkout - Billing Address</h1>

<div style="max-width: 600px;">
    <form method="post" action="/Checkout/BillingAddress">
        <div class="form-group">
            <label>First Name:</label>
            <input type="text" name="firstName" required />
        </div>
        
        <div class="form-group">
            <label>Last Name:</label>
            <input type="text" name="lastName" required />
        </div>
        
        <div class="form-group">
            <label>Email:</label>
            <input type="email" name="email" required />
        </div>
        
        <div class="form-group">
            <label>Address:</label>
            <input type="text" name="address1" required />
        </div>
        
        <div class="form-group">
            <label>City:</label>
            <input type="text" name="city" required />
        </div>
        
        <div class="form-group">
            <label>Zip/Postal Code:</label>
            <input type="text" name="zip" required />
        </div>
        
        <div class="form-group">
            <label>Phone:</label>
            <input type="tel" name="phone" />
        </div>
        
        <div style="display: flex; gap: 10px; margin-top: 2rem;">
            <a href="/ShoppingCart/Cart" class="btn btn-secondary" style="flex: 1; text-align: center;">Back to Cart</a>
            <button type="submit" class="btn" style="flex: 1;">Continue</button>
        </div>
    </form>
</div>
