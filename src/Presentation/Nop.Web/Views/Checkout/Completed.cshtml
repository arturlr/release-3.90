@{
    ViewData["Title"] = "Order Completed";
    var orderId = Context.Request.Query["orderId"].ToString();
}

<div style="text-align: center; padding: 3rem 0;">
    <div style="font-size: 4rem; color: #28a745; margin-bottom: 1rem;">✓</div>
    <h1 style="margin-bottom: 1rem;">Thank You!</h1>
    <p style="font-size: 1.2rem; color: #666; margin-bottom: 2rem;">Your order has been placed successfully</p>
    
    @if (!string.IsNullOrEmpty(orderId))
    {
        <div style="background: #f8f9fa; padding: 20px; border-radius: 4px; max-width: 500px; margin: 0 auto 2rem;">
            <p style="margin-bottom: 10px;">Order Number:</p>
            <p style="font-size: 1.5rem; font-weight: bold; color: #007bff;">#@orderId</p>
        </div>
    }
    
    <p style="color: #666; margin-bottom: 2rem;">
        We've sent a confirmation email to your email address.<br />
        You can track your order status in your account.
    </p>
    
    <div style="display: flex; gap: 10px; justify-content: center;">
        <a href="/Order/CustomerOrders" class="btn">View Orders</a>
        <a href="/Catalog" class="btn btn-secondary">Continue Shopping</a>
    </div>
</div>
