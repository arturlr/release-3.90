@{
    ViewData["Title"] = "Shipping Address";
}

<h1 style="margin-bottom: 2rem;">Checkout - Shipping Address</h1>

<div style="max-width: 600px;">
    <div style="margin-bottom: 2rem;">
        <label style="display: flex; align-items: center; padding: 15px; border: 1px solid #ddd; border-radius: 4px; cursor: pointer;">
            <input type="checkbox" name="sameAsBilling" checked style="margin-right: 10px;" />
            <span>Ship to billing address</span>
        </label>
    </div>

    <form method="post" action="/Checkout/ShippingAddress">
        <div class="form-group">
            <label>First Name:</label>
            <input type="text" name="firstName" required />
        </div>
        
        <div class="form-group">
            <label>Last Name:</label>
            <input type="text" name="lastName" required />
        </div>
        
        <div class="form-group">
            <label>Address:</label>
            <input type="text" name="address1" required />
        </div>
        
        <div class="form-group">
            <label>City:</label>
            <input type="text" name="city" required />
        </div>
        
        <div class="form-group">
            <label>Zip/Postal Code:</label>
            <input type="text" name="zip" required />
        </div>
        
        <div style="display: flex; gap: 10px; margin-top: 2rem;">
            <a href="/Checkout/BillingAddress" class="btn btn-secondary" style="flex: 1; text-align: center;">Back</a>
            <button type="submit" class="btn" style="flex: 1;">Continue</button>
        </div>
    </form>
</div>
