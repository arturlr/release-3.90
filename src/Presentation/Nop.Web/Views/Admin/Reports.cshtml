@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Reports";
}

<h1>Reports & Analytics</h1>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 30px;">
    <div class="stats-card">
        <h3>Sales Report</h3>
        <div style="font-size: 32px; font-weight: bold; color: #28a745; margin: 10px 0;">$0.00</div>
        <p style="color: #666;">Total sales this month</p>
        <a href="#" class="btn btn-sm">View Details</a>
    </div>
    
    <div class="stats-card">
        <h3>Orders Report</h3>
        <div style="font-size: 32px; font-weight: bold; color: #007bff; margin: 10px 0;">0</div>
        <p style="color: #666;">Orders this month</p>
        <a href="#" class="btn btn-sm">View Details</a>
    </div>
    
    <div class="stats-card">
        <h3>Customer Report</h3>
        <div style="font-size: 32px; font-weight: bold; color: #6f42c1; margin: 10px 0;">0</div>
        <p style="color: #666;">New customers this month</p>
        <a href="#" class="btn btn-sm">View Details</a>
    </div>
    
    <div class="stats-card">
        <h3>Product Report</h3>
        <div style="font-size: 32px; font-weight: bold; color: #fd7e14; margin: 10px 0;">0</div>
        <p style="color: #666;">Low stock products</p>
        <a href="#" class="btn btn-sm">View Details</a>
    </div>
</div>

<div class="card" style="margin-bottom: 20px;">
    <h2>Best Selling Products</h2>
    <table>
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity Sold</th>
                <th>Revenue</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="3" style="text-align: center; color: #666;">No data available</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="card">
    <h2>Recent Orders</h2>
    <table>
        <thead>
            <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Total</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="5" style="text-align: center; color: #666;">No orders found</td>
            </tr>
        </tbody>
    </table>
</div>
