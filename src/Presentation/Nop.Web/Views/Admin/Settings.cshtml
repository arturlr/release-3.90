@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Settings";
}

<h1>Store Settings</h1>

<div class="card">
    <h2>General Settings</h2>
    <form method="post" action="/Admin/Setting/Save">
        <div class="form-group">
            <label>Store Name</label>
            <input type="text" name="storeName" value="nopCommerce" />
        </div>
        
        <div class="form-group">
            <label>Store URL</label>
            <input type="text" name="storeUrl" value="https://localhost:5001" />
        </div>
        
        <div class="form-group">
            <label>Admin Email</label>
            <input type="email" name="adminEmail" value="admin@nopcommerce.com" />
        </div>
        
        <div class="form-group">
            <label>
                <input type="checkbox" name="storeClosed" value="true" />
                Store Closed (Maintenance Mode)
            </label>
        </div>
        
        <button type="submit" class="btn btn-success">Save Settings</button>
    </form>
</div>

<div class="card">
    <h2>Catalog Settings</h2>
    <form method="post" action="/Admin/Setting/Save">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
                <label>Products per Page</label>
                <input type="number" name="productsPerPage" value="12" />
            </div>
            
            <div class="form-group">
                <label>Show SKU</label>
                <select name="showSku">
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </div>
        </div>
        
        <div class="form-group">
            <label>
                <input type="checkbox" name="allowCustomersToSearchWithCategoryName" value="true" checked />
                Allow customers to search with category name
            </label>
        </div>
        
        <button type="submit" class="btn btn-success">Save Settings</button>
    </form>
</div>

<div class="card">
    <h2>Order Settings</h2>
    <form method="post" action="/Admin/Setting/Save">
        <div class="form-group">
            <label>Minimum Order Amount</label>
            <input type="number" name="minOrderAmount" value="0" step="0.01" />
        </div>
        
        <div class="form-group">
            <label>
                <input type="checkbox" name="anonymousCheckoutAllowed" value="true" />
                Allow anonymous checkout
            </label>
        </div>
        
        <div class="form-group">
            <label>
                <input type="checkbox" name="termsOfServiceEnabled" value="true" checked />
                Require customers to accept terms of service
            </label>
        </div>
        
        <button type="submit" class="btn btn-success">Save Settings</button>
    </form>
</div>
