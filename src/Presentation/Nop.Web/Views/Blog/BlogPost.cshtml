@model Nop.Core.Domain.News.NewsItem

@{
    ViewData["Title"] = Model?.Title ?? "Blog Post";
}

<div style="margin-bottom: 2rem;">
    <a href="/Blog" style="color: #007bff;">&larr; Back to Blog</a>
</div>

@if (Model == null)
{
    <div class="alert alert-error">Blog post not found</div>
}
else
{
    <article>
        <h1 style="margin-bottom: 0.5rem;">@Model.Title</h1>
        <p style="color: #999; margin-bottom: 2rem;">@Model.CreatedOnUtc.ToString("MMMM dd, yyyy")</p>
        
        <div style="line-height: 1.8; margin-bottom: 2rem;">
            @Html.Raw(Model.Full)
        </div>
    </article>

    <div style="border-top: 2px solid #ddd; padding-top: 2rem; margin-top: 3rem;">
        <h3 style="margin-bottom: 1rem;">Leave a Comment</h3>
        <form method="post" action="/Blog/BlogCommentAdd">
            <input type="hidden" name="blogPostId" value="@Model.Id" />
            <div class="form-group">
                <textarea name="comment" rows="4" placeholder="Your comment..." required></textarea>
            </div>
            <button type="submit" class="btn">Post Comment</button>
        </form>
    </div>
}
