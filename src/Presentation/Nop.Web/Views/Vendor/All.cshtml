@model IList<Nop.Core.Domain.Vendors.Vendor>

@{
    ViewData["Title"] = "All Vendors";
}

<h1 style="margin-bottom: 2rem;">Our Vendors</h1>

@if (Model == null || !Model.Any())
{
    <p>No vendors available.</p>
}
else
{
    <div class="product-grid">
        @foreach (var vendor in Model)
        {
            <div class="product-item">
                <div style="text-align: center; padding: 20px; background: #f8f9fa; margin-bottom: 10px;">
                    <p style="font-size: 2rem;">🏪</p>
                </div>
                <h3>@vendor.Name</h3>
                @if (!string.IsNullOrEmpty(vendor.Description))
                {
                    <p style="color: #666; margin: 10px 0; font-size: 0.9rem;">@vendor.Description</p>
                }
                <a href="/Vendor/Info/@vendor.Id" class="btn">View Store</a>
            </div>
        }
    </div>
}
