@model (Nop.Core.Domain.Vendors.Vendor Vendor, IList<Nop.Core.Domain.Catalog.Product> Products)

@{
    ViewData["Title"] = Model.Vendor?.Name ?? "Vendor";
}

<div style="margin-bottom: 2rem;">
    <a href="/Vendor/All" style="color: #007bff;">&larr; Back to Vendors</a>
</div>

@if (Model.Vendor == null)
{
    <div class="alert alert-error">Vendor not found</div>
}
else
{
    <div style="text-align: center; padding: 2rem 0; border-bottom: 2px solid #ddd; margin-bottom: 2rem;">
        <h1 style="margin-bottom: 1rem;">@Model.Vendor.Name</h1>
        @if (!string.IsNullOrEmpty(Model.Vendor.Description))
        {
            <p style="color: #666; max-width: 600px; margin: 0 auto;">@Model.Vendor.Description</p>
        }
    </div>

    <h2 style="margin-bottom: 1.5rem;">Products from @Model.Vendor.Name</h2>

    @if (Model.Products == null || !Model.Products.Any())
    {
        <p>No products available from this vendor.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var product in Model.Products)
            {
                <div class="product-item">
                    <div style="text-align: center; padding: 20px; background: #f8f9fa; margin-bottom: 10px;">
                        <p style="font-size: 2rem;">📦</p>
                    </div>
                    <h3>@product.Name</h3>
                    @if (!string.IsNullOrEmpty(product.ShortDescription))
                    {
                        <p style="color: #666; margin: 10px 0; font-size: 0.9rem;">@product.ShortDescription</p>
                    }
                    <div class="price">$@product.Price</div>
                    <a href="/Product/ProductDetails/@product.Id" class="btn">View Details</a>
                </div>
            }
        </div>
    }
}
