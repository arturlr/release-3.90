@model IList<Nop.Core.Domain.Orders.ShoppingCartItem>

@{
    ViewData["Title"] = "Wishlist";
}

<h1 style="margin-bottom: 2rem;">My Wishlist</h1>

@if (Model == null || !Model.Any())
{
    <div style="text-align: center; padding: 3rem 0;">
        <p style="font-size: 1.2rem; color: #666; margin-bottom: 2rem;">Your wishlist is empty</p>
        <a href="/Catalog" class="btn">Browse Products</a>
    </div>
}
else
{
    <div class="product-grid">
        @foreach (var item in Model)
        {
            <div class="product-item">
                <div style="text-align: center; padding: 20px; background: #f8f9fa; margin-bottom: 10px;">
                    <p style="font-size: 2rem;">📦</p>
                </div>
                <h3>@item.Product.Name</h3>
                <div class="price">$@item.Product.Price</div>
                <div style="display: flex; gap: 5px; margin-top: 10px;">
                    <form method="post" action="/ShoppingCart/AddProductToCart" style="flex: 1;">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <button type="submit" class="btn" style="width: 100%; padding: 8px; font-size: 0.9rem;">Add to Cart</button>
                    </form>
                    <form method="post" action="/ShoppingCart/DeleteCartItem" style="flex: 0;">
                        <input type="hidden" name="cartItemId" value="@item.Id" />
                        <button type="submit" class="btn btn-secondary" style="padding: 8px 12px; font-size: 0.9rem;">✕</button>
                    </form>
                </div>
            </div>
        }
    </div>
}
