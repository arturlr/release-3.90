@{
    ViewData["Title"] = "Customer Info";
}

<h1 style="margin-bottom: 2rem;">My Account</h1>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">📋 Orders</h3>
        <p style="color: #666; margin-bottom: 1rem;">View your order history and track shipments</p>
        <a href="/Order/CustomerOrders" class="btn">View Orders</a>
    </div>

    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">📍 Addresses</h3>
        <p style="color: #666; margin-bottom: 1rem;">Manage your shipping and billing addresses</p>
        <a href="/Address/List" class="btn">Manage Addresses</a>
    </div>

    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">🛒 Shopping Cart</h3>
        <p style="color: #666; margin-bottom: 1rem;">View items in your cart</p>
        <a href="/ShoppingCart/Cart" class="btn">View Cart</a>
    </div>

    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">❤️ Wishlist</h3>
        <p style="color: #666; margin-bottom: 1rem;">View your saved items</p>
        <a href="/ShoppingCart/Wishlist" class="btn">View Wishlist</a>
    </div>

    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">🔔 Notifications</h3>
        <p style="color: #666; margin-bottom: 1rem;">Manage back in stock subscriptions</p>
        <a href="/BackInStockSubscription/CustomerSubscriptions" class="btn">View Subscriptions</a>
    </div>

    <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
        <h3 style="margin-bottom: 1rem;">🚪 Logout</h3>
        <p style="color: #666; margin-bottom: 1rem;">Sign out of your account</p>
        <a href="/Customer/Logout" class="btn btn-secondary">Logout</a>
    </div>
</div>
