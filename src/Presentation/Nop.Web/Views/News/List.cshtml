@model IList<Nop.Core.Domain.News.NewsItem>

@{
    ViewData["Title"] = "News";
}

<h1 style="margin-bottom: 2rem;">Latest News</h1>

@if (Model == null || !Model.Any())
{
    <p>No news available.</p>
}
else
{
    <div style="display: grid; gap: 20px;">
        @foreach (var news in Model)
        {
            <div style="border: 1px solid #ddd; padding: 20px; border-radius: 4px;">
                <h2 style="margin-bottom: 0.5rem;">
                    <a href="/News/NewsItem/@news.Id" style="color: #333; text-decoration: none;">@news.Title</a>
                </h2>
                <p style="color: #999; font-size: 0.9rem; margin-bottom: 1rem;">
                    @news.CreatedOnUtc.ToString("MMMM dd, yyyy")
                </p>
                <p style="color: #666; line-height: 1.6;">@news.Short</p>
                <a href="/News/NewsItem/@news.Id" style="color: #007bff;">Read more &rarr;</a>
            </div>
        }
    </div>

    <div style="text-align: center; margin-top: 2rem;">
        <a href="/News?page=1" class="btn btn-secondary">Load More</a>
    </div>
}
