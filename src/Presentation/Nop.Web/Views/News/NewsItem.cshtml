@model Nop.Core.Domain.News.NewsItem

@{
    ViewData["Title"] = Model?.Title ?? "News";
}

<div style="margin-bottom: 2rem;">
    <a href="/News" style="color: #007bff;">&larr; Back to News</a>
</div>

@if (Model == null)
{
    <div class="alert alert-error">News item not found</div>
}
else
{
    <article>
        <h1 style="margin-bottom: 0.5rem;">@Model.Title</h1>
        <p style="color: #999; margin-bottom: 2rem;">@Model.CreatedOnUtc.ToString("MMMM dd, yyyy")</p>
        
        <div style="line-height: 1.8; margin-bottom: 2rem;">
            @Html.Raw(Model.Full)
        </div>
    </article>

    <div style="border-top: 2px solid #ddd; padding-top: 2rem; margin-top: 3rem;">
        <h3 style="margin-bottom: 1rem;">Comments</h3>
        <p style="color: #666;">Comments feature coming soon...</p>
    </div>
}
