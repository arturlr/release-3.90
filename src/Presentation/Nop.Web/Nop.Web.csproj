  <!--
    ===================================================================================
    PUBLISH SHAPING - TASK 7.4, RUNTIME DEFERRAL 39 / 7.1-4. SECURITY RELEVANT.
    ===================================================================================
    3.90 shaped its publish output with two custom targets, ExcludeRootBinariesDeployment
    and ExcludeRootBinariesPackage, which built a ~25 entry ExcludeFilesFromDeployment list
    and fed it to ExcludeFromPackageFiles. Both hooked ExcludeFilesFromPackage - an
    MSDeploy / Web Application Project target that DOES NOT EXIST in the Web SDK - so task
    7.1 deleted them and recorded the consequence as deferral 39. This block re-expresses
    the surviving entries in the SDK's own model.

    THE MECHANISM. Both directions are needed, and for opposite reasons:

      (a) The asset trees must be ADDED to publish. Under the classic project ~700 explicit
          <Content Include=.../> entries copied App_Data, Content, Scripts and Themes. The
          SDK classifies .css/.js/.png/.xml/.sql/.ttf/.mmdb as `None`, and `None` items have
          CopyToPublishDirectory=Never by default - so WITHOUT the first ItemGroup below a
          published application would have NO static assets, NO installation scripts, NO
          browscap database and NO PDF font. That is a functional regression, not just
          untidiness, and it is not something the deferral called out.

      (b) Specific files must be WITHHELD. Two of them are the reason this is tagged
          security relevant:
            App_Data/Settings.txt            <- the DATABASE CONNECTION STRING
            Administration/db_backups/*.bak  <- DATABASE BACKUPS
          Publishing either into a web served directory is a data exposure bug.

    `Update` is used rather than `Include` throughout: every one of these files is ALREADY
    an item (the SDK's implicit globbing put it in `None`, or in `Content` for .config and
    .json). `Include` would produce duplicates and fail the build with NETSDK1022; `Update`
    only changes metadata on the existing item, and silently no-ops for a path that does not
    exist - which matters because most of the withheld files are gitignored and only appear
    on a running instance.

    ALREADY HANDLED STRUCTURALLY, no entry needed:
      **\*.cs, **\*.csproj, **\*.csproj.user, **\obj\**, **\bin\*.xml
                              the SDK never publishes source or intermediate output.
      **\packages.config      deleted by task 7.1.
      Administration\bin\**, Administration\db_backups\*.bak
                              `Administration\**` is in DefaultItemExcludes (see the note at
                              the top of this file), so NOTHING under it is an item of this
                              project and it cannot be published from here at all. NOTE FOR
                              TASK 8.x: Nop.Admin is a separate project that in 3.90 dropped
                              its output into Nop.Web\bin, so the db_backups exclusion must
                              be re-expressed in Nop.Admin.csproj, not here.
      bin\Nop.Admin.dll.config, bin\Nop.Web.dll.config
                              app.config derived output; there is no app.config any more.
      **\*.Debug.config, **\*.Release.config
                              Web.Debug.config and Web.Release.config were deleted by task
                              7.4 (unmodified XDT boilerplate; the Web SDK does not run XDT).

    STILL OPEN, and NOT solvable in this file: nothing here stops the static file middleware
    from SERVING a file at runtime. That is the other half of deferral 39 and it is solved by
    the allow-list in Infrastructure\NopStaticFileProvider.cs, which is why App_Data is not
    reachable over HTTP even though it sits under the content root (System.Web blocked
    App_Data implicitly; ASP.NET Core does not).
  -->
  <ItemGroup>
    <!--
      (a) Runtime assets that MUST reach the publish output.

      App_Data - read through CommonHelper.MapPath("~/App_Data/...") against the content root
      (runtime deferral 1.5, closed by task 7.2). Contains browscap.xml (NopConfig
      .UserAgentStringsPath), GeoLite2-Country.mmdb (the geo lookup), Install\*.sql and
      Localization\Installation\*.xml (the installer), and Pdf\FreeSerif.ttf (PdfService).
      Content / Scripts / Themes - served by the static file middleware through
      NopStaticFileProvider, and Themes additionally scanned by ThemeProvider for theme.config.
      The three root files - favicon.ico is what CommonModelFactory falls back to; ErrorPage.htm
      is the file <customErrors defaultRedirect> named and is sent by Program.cs's exception
      handler; FileNotFound.htm is kept for existing links.
    -->
    <None Update="App_Data\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Content\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Scripts\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Themes\**" CopyToPublishDirectory="PreserveNewest" />
    <None Update="favicon.ico" CopyToPublishDirectory="PreserveNewest" />
    <None Update="ErrorPage.htm" CopyToPublishDirectory="PreserveNewest" />
    <None Update="FileNotFound.htm" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      (b) Withheld. These Update items come AFTER the ones above, so they win.
      Every path here is either a SECRET, a machine specific state file, or generated content
      that must not be baked into a deployment.
    -->

    <!-- THE DATABASE CONNECTION STRING. Written by the installer, read by DataSettingsManager. -->
    <None Update="App_Data\Settings.txt" CopyToPublishDirectory="Never" />
    <!-- per-instance installed plugin state -->
    <None Update="App_Data\InstalledPlugins.txt" CopyToPublishDirectory="Never" />
    <!-- generated by BrowscapXmlHelper on first use from browscap.xml; regenerates itself -->
    <None Update="App_Data\browscap.crawlersonly.xml" CopyToPublishDirectory="Never" />
    <!-- database files / backups that may be dropped into App_Data -->
    <None Update="App_Data\*.sdf" CopyToPublishDirectory="Never" />
    <None Update="App_Data\*.mdf" CopyToPublishDirectory="Never" />
    <None Update="App_Data\*.ldf" CopyToPublishDirectory="Never" />
    <None Update="App_Data\*.bak" CopyToPublishDirectory="Never" />

    <!--
      generated picture thumbnails (PictureService writes here at runtime).
      Narrowed to 3.90's exact four extensions rather than the whole directory, because
      Content\Images\Thumbs\placeholder.txt MUST publish: PictureService.DeletePictureThumbs
      calls Directory.GetFiles on this directory and throws DirectoryNotFoundException if it
      does not exist, and GetThumbLocalPath only creates the per-prefix SUBdirectory used when
      MediaSettings.MultipleThumbDirectories is on. The legacy project shipped the placeholder
      via <Content Include="Content\Images\Thumbs\placeholder.txt" /> for the same reason.
      The MultipleThumbDirectories sub-directories are covered by the recursive **\ patterns.
    -->
    <None Update="Content\Images\Thumbs\**\*.jpg" CopyToPublishDirectory="Never" />
    <None Update="Content\Images\Thumbs\**\*.jpeg" CopyToPublishDirectory="Never" />
    <None Update="Content\Images\Thumbs\**\*.png" CopyToPublishDirectory="Never" />
    <None Update="Content\Images\Thumbs\**\*.gif" CopyToPublishDirectory="Never" />
    <!--
      generated export / feed output. Index.htm in the same folder is the directory listing
      placeholder and IS still published, because Nop.Plugin.Feed.GoogleShopping links into
      this folder and expects it to exist.
    -->
    <None Update="Content\files\ExportImport\*.txt" CopyToPublishDirectory="Never" />
    <None Update="Content\files\ExportImport\*.xml" CopyToPublishDirectory="Never" />
    <None Update="Content\files\ExportImport\*.xls" CopyToPublishDirectory="Never" />
    <None Update="Content\files\ExportImport\*.xlsx" CopyToPublishDirectory="Never" />
    <None Update="Content\files\ExportImport\*.pdf" CopyToPublishDirectory="Never" />

    <!--
      NOT in 3.90's list, added deliberately by task 7.4 because the SDK publishes .json and
      .config as Content and these three would otherwise ship.

      The two Views\Web.config files are the important ones and this is NOT cosmetic: both
      declare a <configSections> sectionGroup for System.Web.WebPages.Razor. IIS parses every
      file literally named web.config in the served tree, so publishing them would produce an
      HTTP 500.19 configuration error on an IIS hosted deployment. Task 7.3 recorded both as
      fully superseded by Views\_ViewImports.cshtml and task 7.5 DELETES them; these two
      entries keep publish output correct in the meantime and become harmless no-ops
      afterwards.

      launchSettings.json is developer machine launch configuration and never belongs in a
      deployment.
    -->
    <Content Update="Views\Web.config" CopyToPublishDirectory="Never" />
    <Content Update="Themes\DefaultClean\Views\Web.config" CopyToPublishDirectory="Never" />
    <Content Update="Properties\launchSettings.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

