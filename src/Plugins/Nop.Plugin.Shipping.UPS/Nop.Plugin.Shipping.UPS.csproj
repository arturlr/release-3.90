<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Shipping.UPS - task 14.5
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 5.1, 5.3, 3.1).

    THE RECIPE THIS FOLLOWS is the annotated
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). Only what is DIFFERENT here is documented.

    ===================================================================================
    WHAT IS DIFFERENT (1) - RATING OVER WebRequest, TRACKING OVER SOAP
    ===================================================================================
    UPS is a HYBRID. RATING (UPSComputationMethod.DoRequest) POSTs UPS's XML API with
    (HttpWebRequest)WebRequest.Create(...) - KEPT verbatim like the other WebRequest carriers
    (Australia Post, Canada Post, USPS); SYSLIB0014 left VISIBLE.

    TRACKING (UPSShipmentTracker) called the WSDL-generated TrackService proxy
    (Web References/track/Reference.cs) deriving from
    System.Web.Services.Protocols.SoapHttpClientProtocol, which has NO net10.0 counterpart.
    FOLLOWING THE 4.2 PRECEDENT and the 14.3 FedEx port: the DTOs in Reference.cs are plain
    [XmlType] serializable types that compile unchanged, so ONLY the proxy class was replaced - by
    the hand-built TrackService in Web References/track/TrackService.cs, which calls
    UpsSoapInvoker.cs and reproduces the EXACT SOAP 1.1 / document-literal-bare wire shape,
    INCLUDING the UPSSecurity SOAP header ([SoapHeader("UPSSecurityValue")]). This is an external
    contract with UPS and is recorded prominently in runtime-deferrals.md §14.x-1. UPSSecurity's
    base System.Web.Services.Protocols.SoapHeader was dropped (it is a plain [XmlRoot] type). The
    catch site's System.Web.Services SoapException is replaced by this plugin's own
    SoapException.cs.

    Deleted: Properties/Settings.settings + Settings.Designer.cs (System.Configuration.
    ApplicationSettingsBase, no net10.0 counterpart; its default track URL
    https://wwwcie.ups.com/webservices/Track is transcribed into the hand-built TrackService).
    The Web References .wsdl/.xsd/.map/.datasource data files remain on disk but are NOT compiled.

    ===================================================================================
    DROPPED IN THE CLASSIC -> SDK CONVERSION (Requirements 1.4, 1.5)
    ===================================================================================
    As in the 10.1 template: ToolsVersion/DefaultTargets/xmlns, ProjectGuid etc.; the explicit
    <Compile Include> list; the WebReferences / WebReferenceUrl item groups; the
    Microsoft.CSharp.targets / Microsoft.Bcl.Build.targets imports and guard.

    Every <Reference> with a HintPath into ..\..\packages\ is gone (Microsoft.AspNet.Mvc 5.2.3 /
    Razor 3.2.3 / WebPages 3.2.3 System.Web MVC stack; net40/net45 polyfills). The BCL <Reference>s
    are subsumed by the net10.0 shared framework; System.Web / System.Web.Services have no net10.0
    counterpart. This plugin has NO third-party <PackageReference>: rating uses WebRequest and
    tracking serializes SOAP with System.Xml.Serialization (both in the shared framework).

    app.config, packages.config and web.config are DELETED; web.config's load-bearing content is
    transcribed to Views/_ViewImports.cshtml. Properties/AssemblyInfo.cs is KEPT. Notes.txt stays
    non-deployed Content, as in 3.90.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Shipping.UPS\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!-- Private="false" alone is NOT sufficient - see runtime-deferrals.md section 83.3. -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!-- Keep the retired WSDL/xsd/map/datasource data files out of every item group. -->
  <ItemGroup>
    <None Remove="Web References\**\*.wsdl" />
    <None Remove="Web References\**\*.xsd" />
    <None Remove="Web References\**\*.map" />
    <None Remove="Web References\**\*.datasource" />
  </ItemGroup>

  <!--
    View resolution. %(Link) becomes the compiled Razor identifier, so the view compiles as
    /Plugins/Shipping.UPS/Views/Configure.cshtml and the controller's
    View("~/Plugins/Shipping.UPS/Views/Configure.cshtml", model) call sites stay UNEDITED.
    %(RecursiveDir) already contains "Views/" - do not repeat it.
  -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Shipping.UPS\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
