<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.DiscountRules.HasOneProduct - task 10.2.

    ===================================================================================
    THE RECIPE AND ITS REASONING LIVE IN
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). READ IT BEFORE EDITING THIS FILE OR WRITING THE NEXT PLUGIN.
    ===================================================================================
    Summarised, the four things that fail SILENTLY if they are copied wrongly:

      1. Sdk="Microsoft.NET.Sdk.Razor" + AddRazorSupportForMvc=true. Without the property the
         views compile but the assembly carries no [ProvideApplicationPartFactory], so MVC
         gets an AssemblyPart only and every view is unresolvable (deferral 1.2).
      2. The Content/Link block. It puts the compiled Razor identifiers back at
         /Plugins/DiscountRules.HasOneProduct/Views/..., which is what makes 3.90's explicit
         View("~/Plugins/...") paths keep working unedited. %(RecursiveDir) already contains
         "Views/" - do not repeat it in the Link value.
      3. Private="false" on the ProjectReferences AND the
         NopPluginDoNotDeployHostAssemblies target. The metadata alone leaks Nop.Data.dll from
         the transitive closure, which PluginManager then loads as the process's Nop.Data.
      4. OutputPath + AppendTargetFrameworkToOutputPath=false. Without the second property the
         plugin deploys to Plugins\<ShortName>\net10.0\, whose parent is not "Plugins", so
         PluginManager.IsPackagePluginFolder rejects it and the plugin is invisible.

    Same conversion as 10.1 otherwise: the classic MSBuild scaffolding, the explicit <Compile>
    list, all <Reference> items with HintPaths into ..\..\packages\, app.config,
    packages.config and web.config are gone (web.config's pageBaseType and <namespaces> are
    transcribed to Views/_ViewImports.cshtml); Properties/AssemblyInfo.cs is kept because
    src/Directory.Build.props sets GenerateAssemblyInfo=false.

    This plugin differs from 10.1 in exactly two ways worth noting here:
      * it ships TWO views, one of which (ProductAddPopup.cshtml) is a Kendo-grid popup whose
        Layout and one Html.Partial name views compiled into Nop.Admin.dll - see that file;
      * its controller uses the Kendo grid types, so it binds Nop.Web.Framework.Kendoui.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\DiscountRules.HasOneProduct\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!-- see 10.1 for why the metadata above is not enough on its own -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\DiscountRules.HasOneProduct\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Include, not Update: .txt/.jpg arrive as <None> under the Razor SDK. See 10.1. -->
  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
