@*
    Task 12.1 — the ASP.NET Core replacement for this plugin's deleted web.config
    <system.web.webPages.razor><pages> element (Requirement 4.4). Established by task 10.1;
    every plugin that ships a .cshtml needs one of these, and it must live inside the tree
    covered by the project file's Content/Link glob so Razor resolves it from the same
    (linked) directory as the views themselves.

      pageBaseType="Nop.Web.Framework.ViewEngines.Razor.WebViewPage"
          -> the @inherits directive below. It is what makes T("Some.Resource") resolve and
             what makes the @model type resolve without a fully-qualified name.

      <namespaces> = System.Web.Mvc, System.Web.Mvc.Ajax, System.Web.Mvc.Html,
                     System.Web.Routing
          -> translated exactly as tasks 7.3 / 8.4 / 10.1 translated the same four entries:
             System.Web.Mvc -> Microsoft.AspNetCore.Mvc; System.Web.Mvc.Html ->
             Microsoft.AspNetCore.Mvc.Rendering; System.Web.Routing ->
             Microsoft.AspNetCore.Routing; System.Web.Mvc.Ajax has NO counterpart and is
             dropped (no "Ajax." occurrence in any plugin view).
*@
@inherits Nop.Web.Framework.ViewEngines.Razor.WebViewPage<TModel>

@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Mvc
@using Microsoft.AspNetCore.Mvc.Rendering
@using Microsoft.AspNetCore.Routing

@*
    Nop.Web.Framework carries HtmlExtensions (NopLabelFor / NopEditorFor / NopTextAreaFor /
    OverrideStoreCheckboxFor / LocalizedEditor), ViewCompatibilityExtensions and
    ChildActionExtensions (the @Html.Action bridge, promoted here by task 8.3 and made
    area-aware by task 8.8). One import covers all of them.
*@
@using Nop.Core.Infrastructure
@using Nop.Web.Framework
@using Nop.Web.Framework.UI
@using Nop.Plugin.Payments.CheckMoneyOrder.Models

@*
    Tag helpers. 3.90 had none (they do not exist in MVC 5). Added for the same reason task
    7.3 added them to Nop.Web: the framework's form/validation tag helpers are the supported
    route to an anti-forgery token, and Html.BeginForm uses the same infrastructure.
*@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
