<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Payments.CheckMoneyOrder - task 12.1
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 4.3, 4.4, 5.1, 5.3, 3.1).

    THE PLUGIN RECIPE, applied verbatim. The annotated template with the full reasoning is
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1) and runtime-deferrals.md sections 83-86. The four silently-failing decisions:

      (1) Sdk="Microsoft.NET.Sdk.Razor" + AddRazorSupportForMvc=true. Without the property the
          .cshtml files still compile but the assembly carries no
          [ProvideApplicationPartFactory], MVC gets an AssemblyPart only, and EVERY VIEW IS
          UNRESOLVABLE (deferral 1.2's failure mode).
      (2) the Content/Link block below, which makes the compiled Razor identifiers
          /Plugins/Payments.CheckMoneyOrder/Views/... - byte-identical to 3.90 - so the
          controller's View("~/Plugins/Payments.CheckMoneyOrder/Views/Configure.cshtml") call
          sites are UNCHANGED. %(RecursiveDir) already contains "Views/".
      (3) Private="false" on every ProjectReference AND the NopPluginDoNotDeployHostAssemblies
          target. The metadata alone is not sufficient - a transitive Nop.Data.dll leaks in
          and PluginManager loads it as the process's Nop.Data.
      (4) OutputPath (3.90's, unchanged) + AppendTargetFrameworkToOutputPath=false, or the
          plugin deploys to Plugins\<ShortName>\net10.0\ and IsPackagePluginFolder rejects it.

    DELETED in the classic -> SDK conversion (Requirements 1.3, 1.4, 1.5): packages.config,
    app.config (.NET Framework binding redirects - the concept does not exist on .NET, and
    leaving it risks a .dll.config in the plugin's deployment folder), web.config (the
    per-plugin Razor configuration - a System.Web.WebPages.Razor configSections group, a
    system.web/pages element and the pageBaseType + four System.Web namespaces, all
    transcribed to Views/_ViewImports.cshtml), the explicit <Compile Include> list of 5 files,
    every <Reference> with a HintPath into ..\..\packages\ (the MVC 5 / System.Web stack and
    the net40/net45 BCL polyfills Microsoft.Bcl.Async / Microsoft.Net.Http /
    Microsoft.Web.Infrastructure), the BCL <Reference>s, the Microsoft.CSharp.targets import,
    the Microsoft.Bcl.Build.targets import with its EnsureNuGetPackageBuildImports guard, the
    commented BeforeBuild/AfterBuild stubs, ProjectGuid/ProductVersion/SchemaVersion/
    FileAlignment/AppDesignerFolder/OutputType/TargetFrameworkVersion/Configuration blocks.

    KEPT: Properties/AssemblyInfo.cs. GenerateAssemblyInfo=false is solution-wide
    (src/Directory.Build.props, task 2.3), so deleting it would drop AssemblyVersion to
    0.0.0.0 - measured by tasks 7.5 and 8.1 and asserted by Nop.Web.SmokeTests.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Payments.CheckMoneyOrder\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    The ASP.NET Core shared framework: the controller binds Microsoft.AspNetCore.Mvc
    (Controller, ActionResult, HttpPost) and Microsoft.AspNetCore.Http (IFormCollection - see
    BasePaymentController's remarks), the payment processor binds
    Microsoft.AspNetCore.Routing (RouteValueDictionary). Microsoft.NET.Sdk.Razor does NOT add
    this implicitly, unlike Microsoft.NET.Sdk.Web.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- No <PackageReference>: this plugin has no third-party dependency of its own. -->

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!--
    (3b) Private="false" is NOT sufficient on its own - measured at task 10.1 (section 83.3):
    Nop.Data.dll arrives through the TRANSITIVE ProjectReference closure, which carries the
    default Private=true. This target states the invariant directly ("a plugin deploys its own
    assembly and nothing of nopCommerce's") so it holds whatever the closure turns out to be.
    It filters on the "Nop." prefix precisely so Payments.PayPalDirect's private PayPal SDK
    (task 12.3) still deploys. Asserted at runtime by
    Nop.Web.SmokeTests.PluginViewRenderTests.Task_10_x_a_plugin_deploys_no_other_Nop_assembly.
  -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!-- (2) above. CopyToOutputDirectory="Never": the views are inside the dll now. -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Payments.CheckMoneyOrder\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Runtime-read content, deployed exactly as in 3.90.
      Description.txt  parsed by PluginManager.Initialize; its SupportedVersions list ("3.90")
                       must contain NopVersion.CurrentVersion or the plugin lands in
                       IncompatiblePlugins and is skipped.
      logo.jpg         shown by the admin plugin list.
      Notes.txt        3.90 declared it Content with no CopyToOutputDirectory, i.e. not deployed.

    Include, NOT Update, AND the <None Remove> first: under Microsoft.NET.Sdk.Razor the default
    Content glob covers only .cshtml/.razor, so .txt/.jpg arrive as <None> and a bare
    `<Content Update="Description.txt">` matches NOTHING - the plugin would deploy without its
    Description.txt and PluginManager could not see it at all.
  -->
  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
