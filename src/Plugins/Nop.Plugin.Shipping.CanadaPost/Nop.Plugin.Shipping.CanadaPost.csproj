<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Shipping.CanadaPost - task 14.2
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 5.1, 5.3, 3.1).

    THE RECIPE THIS FOLLOWS is the annotated
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). Read that file for the four silently-failing decisions and the fifth (Content
    Include vs Update for non-.cshtml content). Only what is DIFFERENT here is documented.

    ===================================================================================
    THE CARRIER CALL STAYS ON WebRequest (SYSLIB0014)
    ===================================================================================
    CanadaPostHelper.Request uses (HttpWebRequest)WebRequest.Create(...) to POST/GET the Canada
    Post REST API and, critically, reads `ex.Response` in `catch (WebException ex)` to deserialize
    the carrier's XML <messages> error body. HttpClient.Send does NOT throw on 4xx/5xx, so that
    error-handling path would silently stop working under a naive port. This migration has
    consistently declined the WebRequest -> HttpClient conversion for exactly this reason; kept
    verbatim, the SYSLIB0014 obsoletion warning left VISIBLE. Faithful carrier request shape.

    ===================================================================================
    DROPPED IN THE CLASSIC -> SDK CONVERSION (Requirements 1.4, 1.5)
    ===================================================================================
    As in the 10.1 template: ToolsVersion/DefaultTargets/xmlns, ProjectGuid, ProductVersion,
    SchemaVersion, FileAlignment, AppDesignerFolder, OutputType, TargetFrameworkProfile,
    NuGetPackageImportStamp, TargetFrameworkVersion v4.5.1, Prefer32Bit, ErrorReport,
    WarningLevel, DefineConstants and the Debug/Release blocks; the explicit <Compile Include>
    list of 11 files; the Microsoft.CSharp.targets import, the Microsoft.Bcl.Build.targets import
    and its EnsureNuGetPackageBuildImports guard, and the commented BeforeBuild/AfterBuild stubs.

    Every <Reference> with a HintPath into ..\..\packages\ is gone: the Microsoft.AspNet.Mvc
    5.2.3 / WebPages 3.2.3 System.Web MVC stack. The BCL <Reference>s (System, System.Core,
    System.Xml) are subsumed by the net10.0 shared framework, and <Reference Include="System.Web" />
    has no net10.0 counterpart. This plugin has NO third-party <PackageReference>: it parses the
    carrier reply with System.Xml.Serialization (in the shared framework), not Newtonsoft.Json.

    app.config, packages.config and web.config are DELETED; web.config's load-bearing content is
    transcribed to Views/_ViewImports.cshtml. Properties/AssemblyInfo.cs is KEPT. Notes.txt stays
    non-deployed Content, as in 3.90.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Shipping.CanadaPost\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!-- Private="false" alone is NOT sufficient - see runtime-deferrals.md section 83.3. -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!--
    View resolution. %(Link) becomes the compiled Razor identifier, so the view compiles as
    /Plugins/Shipping.CanadaPost/Views/Configure.cshtml and the controller's
    View("~/Plugins/Shipping.CanadaPost/Views/Configure.cshtml", model) call sites stay UNEDITED.
    %(RecursiveDir) already contains "Views/" - do not repeat it.
  -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Shipping.CanadaPost\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
