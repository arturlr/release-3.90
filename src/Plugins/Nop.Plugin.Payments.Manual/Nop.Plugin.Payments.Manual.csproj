<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Payments.Manual - task 12.2
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 4.3, 4.4, 5.1, 5.3, 3.1).

    THE PLUGIN RECIPE, applied verbatim. Full reasoning: the annotated
    Nop.Plugin.DiscountRules.CustomerRoles.csproj (task 10.1) and runtime-deferrals.md 83-86;
    the group-12 restatement is in Nop.Plugin.Payments.CheckMoneyOrder.csproj (task 12.1). The
    four decisions that fail SILENTLY if copied wrongly are Sdk.Razor + AddRazorSupportForMvc,
    the Content/Link block, Private="false" PLUS the NopPluginDoNotDeployHostAssemblies target,
    and OutputPath PLUS AppendTargetFrameworkToOutputPath=false.

    Deleted: packages.config, app.config, web.config (transcribed to Views/_ViewImports.cshtml),
    the <Compile Include> list, every ..\..\packages\ <Reference>, the BCL <Reference>s, the
    Microsoft.CSharp.targets and Microsoft.Bcl.Build.targets imports plus the
    EnsureNuGetPackageBuildImports guard. Kept: Properties/AssemblyInfo.cs.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Payments.Manual\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    FluentValidation. 3.90 declared it as a <Reference> with
    HintPath=..\..\packages\FluentValidation.6.4.0\lib\Net45\FluentValidation.dll and
    Private=False; Validators/PaymentInfoValidator.cs derives from
    Nop.Web.Framework.Validators.BaseNopValidator<T> and calls RuleFor/NotEmpty/IsCreditCard/
    Matches/WithMessage, so the dependency is real and direct, not transitive-only.

    It becomes a VERSION-LESS PackageReference: the version is pinned centrally in
    src/Directory.Packages.props at 7.6.105, the deliberate repository-wide pin task 6.1 made
    and documented at length there (7.x is the last line whose core package still carries
    FluentValidation.Attributes / AttributedValidatorFactory, which 77 files and
    Nop.Web.Framework's NopValidatorFactory depend on). Nothing here is copied to the plugin's
    output anyway - the host already carries FluentValidation.dll, and a private copy next to
    the plugin would give the process a second FluentValidation, exactly the failure mode the
    NopPluginDoNotDeployHostAssemblies target below prevents for Nop.* assemblies. The
    ExcludeAssets="runtime" metadata is the PackageReference spelling of 3.90's Private=False.
  -->
  <ItemGroup>
    <PackageReference Include="FluentValidation" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Payments.Manual\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!-- Include, NOT Update: under the Razor SDK .txt/.jpg arrive as <None>. -->
  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
