<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Shipping.AustraliaPost - task 14.1
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 5.1, 5.3, 3.1).

    THE RECIPE THIS FOLLOWS is the annotated
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). Read that file for the reasoning behind the four silently-failing decisions
    (AddRazorSupportForMvc, the Content/Link block, Private="false" + the
    NopPluginDoNotDeployHostAssemblies target, AppendTargetFrameworkToOutputPath=false) and the
    fifth (Content Include vs Update for non-.cshtml content). Only what is DIFFERENT about this
    plugin is documented here.

    ===================================================================================
    WHAT IS DIFFERENT (1) - A DIRECT Newtonsoft.Json DEPENDENCY
    ===================================================================================
    AustraliaPostComputationMethod and AustraliaPostExtensions parse the carrier's JSON reply with
    Newtonsoft.Json.Linq (JObject/JArray/JToken). 3.90 carried a HintPath <Reference> to
    Newtonsoft.Json 9.0.1; the SDK spelling is a version-less <PackageReference> resolved by
    src/Directory.Packages.props (central 13.0.4 pin, task 4.1). It carries Private="false"
    metadata for the same reason the ProjectReferences do - the package is present in the host's
    already-loaded closure (Nop.Core/Nop.Services reference it) and a plugin-local copy is dead
    weight; the "Nop." prefix filter in NopPluginDoNotDeployHostAssemblies does not cover it, so
    the metadata is what keeps Newtonsoft.Json.dll out of the plugin's deployment folder.

    ===================================================================================
    WHAT IS DIFFERENT (2) - THE CARRIER CALL STAYS ON WebRequest (SYSLIB0014)
    ===================================================================================
    RequestShippingOptions uses WebRequest.Create(...) as HttpWebRequest to GET the Australia
    Post digital API. This migration has consistently DECLINED the WebRequest -> HttpClient
    conversion (Nop.Core, Nop.Services, Nop.Admin, EcbExchange, PayPalStandard) because the
    semantics differ (GetResponse() throws on 4xx/5xx where HttpClient.Send does not, and this
    code relies on that: `catch (WebException ex) { stream = ex.Response.GetResponseStream(); }`),
    and a correct HttpClient port needs a static client. Kept verbatim; the resulting SYSLIB0014
    obsoletion warning is left VISIBLE, consistent with the earlier plugins. This is a carrier
    request shape and a faithful port is the priority.

    ===================================================================================
    DROPPED IN THE CLASSIC -> SDK CONVERSION (Requirements 1.4, 1.5)
    ===================================================================================
    As in the 10.1 template: ToolsVersion/DefaultTargets/xmlns, ProjectGuid, ProductVersion,
    SchemaVersion, FileAlignment, AppDesignerFolder, OutputType, TargetFrameworkProfile,
    NuGetPackageImportStamp, TargetFrameworkVersion v4.5.1, Prefer32Bit, ErrorReport,
    WarningLevel, DefineConstants and the Debug/Release DebugType/DebugSymbols/Optimize blocks;
    the explicit <Compile Include> list of 6 files; the Microsoft.CSharp.targets import, the
    Microsoft.Bcl.Build.targets import and its EnsureNuGetPackageBuildImports guard, and the
    commented BeforeBuild/AfterBuild stubs.

    Every <Reference> with a HintPath into ..\..\packages\ is gone: the Microsoft.AspNet.Mvc
    5.2.3 / Razor 3.2.3 / WebPages 3.2.3 System.Web MVC stack, Newtonsoft.Json 9.0.1 (now a
    PackageReference, see above) and the net40/net45 polyfills Microsoft.Bcl.Async,
    Microsoft.Net.Http and Microsoft.Web.Infrastructure. The BCL <Reference>s (System,
    System.Core, System.Net, System.Net.Http, System.Net.Http.WebRequest) are subsumed by the
    net10.0 shared framework, and <Reference Include="System.Web" /> has no net10.0 counterpart.

    app.config, packages.config and web.config are DELETED; web.config's load-bearing content is
    transcribed to Views/_ViewImports.cshtml. Properties/AssemblyInfo.cs is KEPT. Notes.txt stays
    non-deployed Content, as in 3.90.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Shipping.AustraliaPost\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    The ASP.NET Core shared framework - required explicitly (Microsoft.NET.Sdk.Razor does not add
    it implicitly). The controller binds Microsoft.AspNetCore.Mvc, the computation method binds
    Microsoft.AspNetCore.Routing (RouteValueDictionary on IShippingRateComputationMethod's
    GetConfigurationRoute).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!-- Private="false" alone is NOT sufficient - see runtime-deferrals.md section 83.3. -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!--
    View resolution. %(Link) becomes the compiled Razor identifier, so the view compiles as
    /Plugins/Shipping.AustraliaPost/Views/Configure.cshtml and the controller's
    View("~/Plugins/Shipping.AustraliaPost/Views/Configure.cshtml", model) call site stays
    UNEDITED. %(RecursiveDir) already contains "Views/" - do not repeat it.
  -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Shipping.AustraliaPost\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Runtime-read content, deployed exactly as in 3.90. Include, NOT Update - AND the <None Remove>
    first; under Microsoft.NET.Sdk.Razor the default Content glob covers only .cshtml/.razor, so a
    bare <Content Update="Description.txt"> would match NOTHING and PluginManager could not see
    the plugin at all.
  -->
  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
