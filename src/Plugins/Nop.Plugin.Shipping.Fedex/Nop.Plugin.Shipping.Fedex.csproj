<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Shipping.Fedex - task 14.3
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 5.1, 5.3, 3.1).

    THE RECIPE THIS FOLLOWS is the annotated
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). Only what is DIFFERENT here is documented.

    ===================================================================================
    WHAT IS DIFFERENT - THE FedEx CARRIER IS REACHED OVER SOAP, AND THE PROXY WAS UNPORTABLE
    ===================================================================================
    3.90 called FedEx via TWO WSDL-generated proxies deriving from
    System.Web.Services.Protocols.SoapHttpClientProtocol - RateService
    (Web References/RateServiceWebReference/Reference.cs, ~16,700 lines) and TrackService
    (TrackService.cs, ~4,850 lines). SoapHttpClientProtocol has NO net10.0 counterpart.

    FOLLOWING THE 4.2 PRECEDENT (the EU VAT ASMX proxy, which task 4.2 replaced with a hand-built
    HttpClient SOAP envelope - runtime-deferrals.md §7.16 / §16): the DTO classes in both files are
    plain [XmlType]-annotated serializable types that compile UNCHANGED on net10.0, so ONLY the two
    SoapHttpClientProtocol-derived proxy classes were replaced. The replacements
    (Web References/RateServiceWebReference/RateService.cs and the hand-built TrackService in
    TrackService.cs) call FedexSoapInvoker.cs, which reproduces the EXACT SOAP 1.1 /
    document-literal-bare wire shape the generated proxies sent - because that request shape is an
    external contract with FedEx. This is recorded prominently in runtime-deferrals.md §14.x-1.

    Deleted: Properties/Settings.settings + Settings.Designer.cs (System.Configuration.
    ApplicationSettingsBase, no net10.0 counterpart; only the removed RateService proxy read the
    default URL, and the computation method always sets service.Url = FedexSettings.Url first, so
    the setting was dead). The Web References .wsdl/.map/.datasource data files are left on disk but
    are NOT compiled (the SDK globs only .cs) - inert. The catch sites' System.Web.Services
    SoapException is replaced by this plugin's own SoapException.cs (same XmlNode Detail shape).

    ===================================================================================
    DROPPED IN THE CLASSIC -> SDK CONVERSION (Requirements 1.4, 1.5)
    ===================================================================================
    As in the 10.1 template: ToolsVersion/DefaultTargets/xmlns, ProjectGuid, ProductVersion,
    SchemaVersion, FileAlignment, AppDesignerFolder, OutputType, TargetFrameworkProfile,
    NuGetPackageImportStamp, TargetFrameworkVersion v4.5.1, Prefer32Bit, ErrorReport,
    WarningLevel, DefineConstants and the Debug/Release blocks; the explicit <Compile Include>
    list; the WebReferences / WebReferenceUrl item groups; the Microsoft.CSharp.targets import,
    the Microsoft.Bcl.Build.targets import and its guard, and the BeforeBuild/AfterBuild stubs.

    Every <Reference> with a HintPath into ..\..\packages\ is gone: the Microsoft.AspNet.Mvc
    5.2.3 / Razor 3.2.3 / WebPages 3.2.3 System.Web MVC stack and the net40/net45 polyfills.
    The BCL <Reference>s (System, System.Core, System.EnterpriseServices, System.Net,
    System.Net.Http, System.Net.Http.WebRequest, System.Web.Services, System.Xml.Linq,
    System.Data.DataSetExtensions, Microsoft.CSharp, System.Data, System.Xml) are subsumed by the
    net10.0 shared framework or, in the case of System.Web / System.Web.Services, have no net10.0
    counterpart at all.

    app.config, packages.config and web.config are DELETED; web.config's load-bearing content is
    transcribed to Views/_ViewImports.cshtml. Properties/AssemblyInfo.cs is KEPT. Notes.txt stays
    non-deployed Content, as in 3.90. This plugin has NO third-party <PackageReference>: it now
    serializes SOAP with System.Xml.Serialization (shared framework).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Shipping.Fedex\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!-- Private="false" alone is NOT sufficient - see runtime-deferrals.md section 83.3. -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!--
    Keep the retired WSDL/map/datasource data files out of every item group. They are no longer
    read by anything (the generated proxies that consumed them are replaced) but remain on disk.
  -->
  <ItemGroup>
    <None Remove="Web References\**\*.wsdl" />
    <None Remove="Web References\**\*.map" />
    <None Remove="Web References\**\*.datasource" />
  </ItemGroup>

  <!--
    View resolution. %(Link) becomes the compiled Razor identifier, so the view compiles as
    /Plugins/Shipping.Fedex/Views/Configure.cshtml and the controller's
    View("~/Plugins/Shipping.Fedex/Views/Configure.cshtml", model) call sites stay UNEDITED.
    %(RecursiveDir) already contains "Views/" - do not repeat it.
  -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Shipping.Fedex\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
