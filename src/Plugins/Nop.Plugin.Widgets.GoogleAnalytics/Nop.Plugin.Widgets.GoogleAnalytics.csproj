<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Widgets.GoogleAnalytics - task 15.2
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 4.3, 4.4, 5.1, 5.3, 3.1).

    THE RECIPE THIS FOLLOWS is the annotated
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). Read that file for the reasoning behind the five silently-failing decisions. This
    is the thinnest plugin in the group: no DbContext, no static assets, one Configure view. Only
    what is notable is documented here.

    ===================================================================================
    THIS IS AN IWidgetPlugin (the Html.Action bridge, deferral 7.3-1)
    ===================================================================================
    GoogleAnalyticPlugin implements IWidgetPlugin, so its PublicInfo action is rendered inline in
    the storefront through @Html.Action(widget.ActionName, widget.ControllerName,
    widget.RouteValues) in Views/Shared/Components/Widget/Default.cshtml. That bridge is
    Nop.Web.Framework/ChildActionExtensions.cs (promoted from Nop.Web by task 8.3, made
    area-aware by 8.8, made constraint-aware by 11.1). Nothing in this plugin has to do anything
    for it beyond exposing the action/controller/RouteValueDictionary triple, which GetConfigurationRoute
    and GetDisplayWidgetRoute already do.

    ===================================================================================
    DROPPED IN THE CLASSIC -> SDK CONVERSION (Requirements 1.4, 1.5)
    ===================================================================================
    As in the 10.1 template: ToolsVersion/DefaultTargets/xmlns, ProjectGuid, ProductVersion,
    SchemaVersion, FileAlignment, AppDesignerFolder, OutputType, TargetFrameworkProfile,
    NuGetPackageImportStamp, TargetFrameworkVersion v4.5.1, Prefer32Bit, ErrorReport,
    WarningLevel, DefineConstants and the Debug/Release blocks; the explicit <Compile Include>
    list; the Microsoft.CSharp.targets / Microsoft.Bcl.Build.targets imports and the
    EnsureNuGetPackageBuildImports guard; every <Reference> with a HintPath into ..\..\packages\
    (the Microsoft.AspNet.Mvc 5.2.3 / Razor 3.2.3 / WebPages 3.2.3 System.Web MVC stack, Autofac,
    and the net40/net45 polyfills); the BCL <Reference>s; and <Reference Include="System.Web" />,
    which has no net10.0 counterpart at all.

    app.config, packages.config and web.config are DELETED; web.config's load-bearing content is
    transcribed to Views/_ViewImports.cshtml. Properties/AssemblyInfo.cs is KEPT. Notes.txt stays
    non-deployed Content, as in 3.90. No <PackageReference>: no third-party dependency of its own.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Widgets.GoogleAnalytics\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    Required explicitly - Microsoft.NET.Sdk.Razor does not add it implicitly. The controller binds
    Microsoft.AspNetCore.Mvc (+ .Rendering for SelectListItem, + Microsoft.AspNetCore.Http for
    Request.RouteValues in PublicInfo) and the plugin class binds Microsoft.AspNetCore.Routing
    (RouteValueDictionary, on IWidgetPlugin's GetConfigurationRoute / GetDisplayWidgetRoute).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!--
    Private="false" alone is NOT sufficient - a transitive Nop.Data.dll leaks in through the
    ProjectReference closure. See runtime-deferrals.md section 83.3. Verbatim from the template;
    the "Nop." prefix filter keeps Payments.PayPalDirect's private PayPal SDK working (task 12.3).
  -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!--
    View resolution. %(Link) becomes the compiled Razor identifier, so the view compiles as
    /Plugins/Widgets.GoogleAnalytics/Views/Configure.cshtml and the controller's
    View("~/Plugins/Widgets.GoogleAnalytics/Views/Configure.cshtml", model) call site stays
    UNEDITED. %(RecursiveDir) already contains "Views/" - do not repeat it.
  -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Widgets.GoogleAnalytics\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <!--
    Runtime-read content, deployed exactly as in 3.90. Include, NOT Update - AND the <None Remove>
    first; under Microsoft.NET.Sdk.Razor the default Content glob covers only .cshtml/.razor.
  -->
  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
