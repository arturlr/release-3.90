<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Nop.Plugin.Shipping.FixedOrByWeight - task 14.4
    (Requirements 5.5, 1.1-1.5, 2.4, 4.2, 4.3, 4.4, 5.1, 5.3, 3.1).

    THE RECIPE THIS FOLLOWS is the annotated
    src/Plugins/Nop.Plugin.DiscountRules.CustomerRoles/Nop.Plugin.DiscountRules.CustomerRoles.csproj
    (task 10.1). Read that file for the four silently-failing decisions and the fifth (Content
    Include vs Update for non-.cshtml content). This is the OUTLIER of group 14: it is the only
    Shipping.* plugin with its own EF DbContext, an IRouteProvider, and 6 views.

    ===================================================================================
    WHAT IS DIFFERENT (1) - THIS PLUGIN HAS ITS OWN DbContext (runtime deferral 4.10)
    ===================================================================================
    Data\ShippingByWeightObjectContext.cs is an EF context, registered by DependencyRegistrar
    through Nop.Web.Framework's RegisterPluginDataContext. It is the 14.4 quarter of deferral
    4.10 - the third of the four plugin contexts (after 11.2 Feed.GoogleShopping and 13.1
    Pickup.PickupInStore). Its Install() calls the SHARED helper
    Nop.Data.DbContextExtensions.ExecuteSqlScript (task 11.2, §92.3) which splits EF Core's
    GO-batched GenerateCreateScript() output - the splitter is NOT re-derived here. This is why
    the project references Nop.Data DIRECTLY (the legacy project did too, alongside EF6
    <Reference>s that are NOT restated: EntityFramework 6 / EntityFramework.SqlServer have no
    place in this solution any more, and EF Core arrives transitively through Nop.Data, task 3.1).
    Worked example: Nop.Plugin.Feed.GoogleShopping/Data/GoogleProductObjectContext.cs.

    ===================================================================================
    WHAT IS DIFFERENT (2) - AN IRouteProvider (Requirement 4.6)
    ===================================================================================
    RouteProvider.cs registers three admin routes. Ported to
    RegisterRoutes(IEndpointRouteBuilder) with MapControllerRoute per §17.4a / deferral 83.6;
    route names, URL patterns and defaults are 3.90's. No <PackageReference> is needed for it.

    ===================================================================================
    DROPPED IN THE CLASSIC -> SDK CONVERSION (Requirements 1.4, 1.5)
    ===================================================================================
    As in the 10.1 template: ToolsVersion/DefaultTargets/xmlns, ProjectGuid, ProductVersion,
    SchemaVersion, FileAlignment, AppDesignerFolder, OutputType, TargetFrameworkProfile,
    NuGetPackageImportStamp, TargetFrameworkVersion v4.5.1, Prefer32Bit, ErrorReport,
    WarningLevel, DefineConstants and the Debug/Release blocks; the explicit <Compile Include>
    list; the Microsoft.CSharp.targets import, the Microsoft.Bcl.Build.targets import and its
    EnsureNuGetPackageBuildImports guard, and the commented BeforeBuild/AfterBuild stubs.

    Every <Reference> with a HintPath into ..\..\packages\ is gone: the Microsoft.AspNet.Mvc
    5.2.3 / WebPages 3.2.3 System.Web MVC stack and the EF6 <Reference>s. The BCL <Reference>s
    are subsumed by the net10.0 shared framework, and <Reference Include="System.Web" /> has no
    net10.0 counterpart. Data\EfStartUpTask.cs is DELETED - its sole statement,
    Database.SetInitializer<...>(null), targets EF6's initializer pipeline, which EF Core does
    not have; there is no counterpart to port (same decision as Feed.GoogleShopping, §92.3).

    app.config, packages.config and web.config are DELETED; web.config's load-bearing content is
    transcribed to Views/_ViewImports.cshtml. Properties/AssemblyInfo.cs is KEPT. Notes.txt stays
    non-deployed Content, as in 3.90.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <OutputPath>..\..\Presentation\Nop.Web\Plugins\Shipping.FixedOrByWeight\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <!--
    The ASP.NET Core shared framework - required explicitly (Microsoft.NET.Sdk.Razor does not add
    it implicitly). The controller binds Microsoft.AspNetCore.Mvc (+ .Rendering for SelectListItem),
    the RouteProvider binds Microsoft.AspNetCore.Routing / .Builder (IEndpointRouteBuilder,
    MapControllerRoute), and the computation method binds Microsoft.AspNetCore.Routing.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Nop.Core\Nop.Core.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Data\Nop.Data.csproj" Private="false" />
    <ProjectReference Include="..\..\Libraries\Nop.Services\Nop.Services.csproj" Private="false" />
    <ProjectReference Include="..\..\Presentation\Nop.Web.Framework\Nop.Web.Framework.csproj" Private="false" />
  </ItemGroup>

  <!--
    Private="false" alone is NOT sufficient - see runtime-deferrals.md section 83.3. This plugin
    is the case that makes the point sharpest for group 14: it references Nop.Data DIRECTLY, so
    Nop.Data.dll would be copied here by name rather than by transitive accident, and
    PluginManager would shadow-copy and load it as the process's Nop.Data.
  -->
  <Target Name="NopPluginDoNotDeployHostAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="$([System.String]::Copy('%(Filename)').StartsWith('Nop.'))" />
    </ItemGroup>
  </Target>

  <!--
    View resolution. %(Link) becomes the compiled Razor identifier, so each view compiles as
    /Plugins/Shipping.FixedOrByWeight/Views/<name>.cshtml and the controller's
    View("~/Plugins/Shipping.FixedOrByWeight/Views/<name>.cshtml", model) call sites AND the
    inter-view @Html.Partial("~/Plugins/Shipping.FixedOrByWeight/Views/...") references stay
    UNEDITED. %(RecursiveDir) already contains "Views/" - do not repeat it.
  -->
  <ItemGroup>
    <Content Update="Views\**\*.cshtml"
             Link="Plugins\Shipping.FixedOrByWeight\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Description.txt" />
    <None Remove="logo.jpg" />
    <None Remove="Notes.txt" />
    <Content Include="Description.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="logo.jpg" CopyToOutputDirectory="Always" />
    <Content Include="Notes.txt" CopyToOutputDirectory="Never" />
  </ItemGroup>

</Project>
